/* =====================================================================
   SPIN ARENA
   ===================================================================== */
const $ = s => document.querySelector(s);
const clamp = (v,a,b)=>Math.max(a,Math.min(b,v));
const rand = (a,b)=>a+Math.random()*(b-a);
const TAU = Math.PI*2;

function hexRgb(h){h=h.replace('#','');if(h.length===3)h=h.split('').map(c=>c+c).join('');const n=parseInt(h,16);return[(n>>16)&255,(n>>8)&255,n&255];}
function shade(h,amt){const[r,g,b]=hexRgb(h);const t=amt<0?0:255,p=Math.abs(amt);return`rgb(${Math.round((t-r)*p+r)},${Math.round((t-g)*p+g)},${Math.round((t-b)*p+b)})`;}
function rgba(h,a){const[r,g,b]=hexRgb(h);return`rgba(${r},${g},${b},${a})`;}

/* ---------------- constants & fighter definitions ---------------- */
const R = 380;          // arena radius (world units)
const AURA = 160;       // Whirl gravity radius (bumped with the bigger fighters)
const DEBRIS_PULL = 2600;   // px/s^2 Whirl's field applies to scraps at point-blank range
const DEBRIS_REACH = 1.5;   // scraps feel the field out to this multiple of the visible aura
const PULL = 520;       // Whirl pull force
const DOT_DPS = 125;     // Whirl max damage per second (rival right next to her)
const RAGE_TIME = 9;   // seconds for Big Boy to reach full speed
const SIM_DT = 1/60;   // fixed simulation tick (seconds)
const SCAR_MAX = 12;      // impact scars kept per fighter
const SCAR_COOL = 2.5;    // seconds for a welt to cool from white-hot to a dark dent
const STALL_TIME = .4;    // motor stall after a massive hit
const LAST_STAND = .2;    // HP fraction that triggers the Last Stand burst and heartbeat
// hit-stop lengths in sim ticks (60 Hz): one place to tune the "weight" of impacts
const HITSTOP = {chip:1, medium:1, massive:2, ko:6};
function hitStop(g,ticks){ g.hitStop=Math.max(g.hitStop,ticks); }

// Clockwork's tick cycle. The timer runs on real sim time (never dilated), so "5 seconds" is 5 real seconds.
// boost scales base speed, acceleration and spin. Cycle 3 is the max and repeats.
const CW_CYCLES = [
  {ticks:12, iv:1.0,   burn:3, boost:1.0},
  {ticks:10, iv:.75,   burn:2, boost:1.1},
  {ticks:8,  iv:.625,  burn:1, boost:1.2}
];
const CW_OVER = 5;          // Overdrive ("Sandevistan") length in seconds
const CW_OVER_BOOST = 1.5;  // Clockwork's speed / acceleration / spin multiplier in Overdrive
const CW_SLOW = .2;         // everyone else's time scale in Overdrive
const CW_OVER_HITCD = .4;   // Clockwork's hit cooldown in Overdrive (normal is .35)
const CW_OVER_DMG = 1.6;    // Clockwork's contact-damage multiplier in Overdrive (was a .7 cap)
const CW_OVER_TAKEN = .3;   // damage Clockwork still takes in Overdrive (30%), from touch, shrapnel and burns
const CW_WALK = .45;        // AI gait: walk speed / accel as a fraction of the run (wind-up only)
const CW_GHOST_MAX = 8, CW_GHOST_LIFE = .32;
// Beyblade-style collisions (resolveCollision) and AI steering
const E_FIGHT = 2.0;        // impulse factor on the closing speed (2.0 = perfectly elastic)
const E_WALL = 1.9;         // same for the arena wall
const SEP_MIN = 170;        // minimum separating speed (px/s) after any closing contact, so slow hits still fling apart
const SEP_SOFT = 90;        // gentler kick for overlapping but non-closing pairs (the old "grinding" case)
const SPIN_KICK = .12;      // tangential kick = surface slip speed (spin*r) * this
const JT_MAX = 140;         // cap on the spin-kick (px/s of relative speed)
const STEER_T = .25;        // AI steering dampener after a hit (seconds, ~15 ticks)
const RIC_MIN = 430;        // separating speed above which a hit also plays the ricochet sound
const BANK_BOOST = .35;     // Big Boy wall-bank: extra top speed (deliberately modest)
// Scrap-King: magnetic salvage, orbiting scrap ring, polarity blast
const SK_MAG = 230;         // magnetic pull radius (px from its centre)
const SK_PULL = 2300;       // px/s^2 the magnet applies to loose debris at point-blank range
const SK_RING = 24;         // orbit radius of the scrap ring beyond the chassis edge
const SK_GAIN = 22;         // orbit spring: px/s of correction per px of slot error
const SK_PR = 10;           // effective radius of a ring piece when it touches a rival
const SK_SHIELD = .45;      // damage Scrap-King shrugs off with a full ring (reached at 6 pieces)
const SK_SHRED_CD = .45;    // seconds between shred hits on the same rival
const SK_SHOVE = 150;       // px/s shove a rival gets when it plows into the ring
const SK_WEAR = 5;          // wear points before a ring piece breaks into fragments
const SK_BLAST_V = [850,1150];   // polarity blast launch speed (px/s)
const SK_BLAST_BIAS = .4;   // how far each piece's radial direction leans toward the rival (slight, so it can miss)
const SK_BLAST_CAP = 8;     // total HP one blast can take
const SK_RANGE = 300;       // the AI fires when the rival is within chassis edge + this
const SK_FALL_MAX = 6;      // rim shards Scrap-King may rip loose per match
function angDiff(a,b){const d=a-b; return Math.atan2(Math.sin(d),Math.cos(d));}

