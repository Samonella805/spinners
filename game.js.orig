  {u:'KeyW',d:'KeyS',l:'KeyA',r:'KeyD'},
  {u:'ArrowUp',d:'ArrowDown',l:'ArrowLeft',r:'ArrowRight'}
];

/* ---------------- canvas ---------------- */
const cv = $('#cv'), ctx = cv.getContext('2d');
let W=0,H=0,DPR=1;
function resize(){
  DPR = Math.min(2, window.devicePixelRatio||1);
  W = innerWidth; H = innerHeight;
  cv.width = W*DPR; cv.height = H*DPR;
  cv.style.width = W+'px'; cv.style.height = H+'px';
}
addEventListener('resize', resize); resize();

/* =====================================================================
   DRAWING THE TOPS
   ===================================================================== */
function polyPath(c,pts){c.beginPath();pts.forEach((q,k)=>k?c.lineTo(q[0],q[1]):c.moveTo(q[0],q[1]));c.closePath();}
function polar(list,r){return list.map(([a,rr])=>[Math.cos(a)*rr*r,Math.sin(a)*rr*r]);}
const TOOTH_W=Math.PI/10*.86;
function toothPts(r){return polar([[-TOOTH_W,.84],[-TOOTH_W*.4,1],[TOOTH_W*.4,1],[TOOTH_W,.84]],r);}
function tipPts(r){const w=TOOTH_W;return polar([[-w*.4,1],[w*.4,1],[w*.34,.9],[-w*.34,.9]],r);}
function drawTooth(c,r,i,c1,c2){
  polyPath(c,toothPts(r)); c.fillStyle=i%2?'#3b3e52':'#4b4f69'; c.fill();
  c.lineWidth=r*.045; c.lineJoin='round'; c.strokeStyle='#0d0e14'; c.stroke();
  polyPath(c,tipPts(r)); c.fillStyle=i%2?c2:c1; c.fill();
}
function bladePath(c,r){
  c.beginPath(); c.moveTo(r*.25,-r*.12);
  c.quadraticCurveTo(r*.8,-r*.8,r*1.0,r*.1);
  c.quadraticCurveTo(r*.66,-r*.2,r*.25,r*.22); c.closePath();
}
function drawBig(c,r,c1,c2,rage,parts){
  const N=10;
  c.save(); c.shadowColor='#ff6a00'; c.shadowBlur=rage*34;
  c.fillStyle='#1c1d27'; c.beginPath(); c.arc(0,0,r*.86,0,TAU); c.fill(); c.restore();
  for(let i=0;i<N;i++){
    c.save(); c.rotate(i/N*TAU);
    if(!parts||parts[i].alive) drawTooth(c,r,i,c1,c2);
    else {
      c.fillStyle='#14151c'; c.beginPath();
      c.moveTo(r*.84,-r*.2); c.lineTo(r*.93,-r*.06); c.lineTo(r*.89,r*.07); c.lineTo(r*.84,r*.2); c.closePath(); c.fill();
    }
    c.restore();
  }
  c.lineWidth=r*.05; c.strokeStyle=c2; c.beginPath(); c.arc(0,0,r*.84,0,TAU); c.stroke();
  const g=c.createRadialGradient(-r*.22,-r*.22,r*.05,0,0,r*.74);
  g.addColorStop(0,shade(c1,.4)); g.addColorStop(1,shade(c1,-.45));
  c.fillStyle=g; c.beginPath(); c.arc(0,0,r*.72,0,TAU); c.fill();
  c.lineWidth=r*.045; c.strokeStyle='#0d0e14'; c.stroke();
  for(let i=0;i<4;i++){ // four-fang star
    c.save(); c.rotate(i*TAU/4+Math.PI/4);
    c.beginPath(); c.moveTo(r*.18,-r*.15); c.lineTo(r*.66,0); c.lineTo(r*.18,r*.15); c.closePath();
    c.fillStyle=c2; c.fill(); c.lineWidth=r*.035; c.lineJoin='round'; c.strokeStyle='#0d0e14'; c.stroke();
    c.restore();
  }
  c.fillStyle='#15161d'; c.beginPath(); c.arc(0,0,r*.24,0,TAU); c.fill();
  c.save(); c.shadowColor=c2; c.shadowBlur=6+rage*20; c.fillStyle=rage>.6?'#ffffff':c2;
  c.beginPath(); c.arc(0,0,r*.12+rage*r*.04,0,TAU); c.fill(); c.restore();
  if(rage>.05){c.strokeStyle=`rgba(255,120,40,${rage})`; c.lineWidth=r*.05; c.beginPath(); c.arc(0,0,r*.93,0,TAU); c.stroke();}
}
function drawWhirl(c,r,c1,c2,parts){
  for(let i=0;i<3;i++){
    c.save(); c.rotate(i*TAU/3);
    if(!parts||parts[i].alive){
      c.shadowColor=c2; c.shadowBlur=14; bladePath(c,r); c.fillStyle=c2; c.fill();
      c.shadowBlur=0; c.lineWidth=r*.045; c.lineJoin='round'; c.strokeStyle='#0d0e14'; c.stroke();
    } else {
      c.fillStyle='#14151c'; c.beginPath();
      c.moveTo(r*.25,-r*.1); c.lineTo(r*.5,-r*.2); c.lineTo(r*.42,r*.15); c.lineTo(r*.25,r*.2); c.closePath(); c.fill();
    }
    c.restore();
  }
  const g=c.createRadialGradient(-r*.15,-r*.15,r*.05,0,0,r*.65);
  g.addColorStop(0,shade(c1,.4)); g.addColorStop(1,shade(c1,-.5));
  c.fillStyle=g; c.beginPath(); c.arc(0,0,r*.62,0,TAU); c.fill();
  c.lineWidth=r*.045; c.strokeStyle='#0d0e14'; c.stroke();
  c.strokeStyle=c2; c.lineWidth=r*.07; c.lineCap='round';
  for(let k=0;k<3;k++){ // spiral emblem
    c.beginPath();
    for(let s=0;s<=14;s++){const u=s/14,a=k*TAU/3+u*2.2,rr=r*(.1+.4*u); s?c.lineTo(Math.cos(a)*rr,Math.sin(a)*rr):c.moveTo(Math.cos(a)*rr,Math.sin(a)*rr);}
    c.stroke();
  }
  c.save(); c.shadowColor=c2; c.shadowBlur=10; c.fillStyle='#ffffff'; c.beginPath(); c.arc(0,0,r*.09,0,TAU); c.fill(); c.restore();
}
/* ---- Clockwork: brass gear with hour teeth, meshing cogs, an upright Roman-numeral dial and hands ---- */
const CW_N=12, COG_W=TAU/CW_N/2*.78, ROMAN=['XII','I','II','III','IV','V','VI','VII','VIII','IX','X','XI'];
function cogToothPts(r){return polar([[-COG_W,.82],[-COG_W*.72,1],[COG_W*.72,1],[COG_W,.82]],r);}
function drawCogTooth(c,r,i,c1,c2){
  polyPath(c,cogToothPts(r)); c.fillStyle=i%2?shade(c1,-.2):c1; c.fill();
  c.lineWidth=r*.04; c.lineJoin='round'; c.strokeStyle='#2a1708'; c.stroke();
  polyPath(c,polar([[-COG_W*.5,.97],[COG_W*.5,.97],[COG_W*.44,.89],[-COG_W*.44,.89]],r)); c.fillStyle=c2; c.fill();
}
function cogPath(c,rad,n){
  const s=TAU/n; c.beginPath();
  for(let i=0;i<n;i++){
    const a=i*s;
    [[-.3,.76],[-.2,1],[.2,1],[.3,.76]].forEach(([da,rr],k)=>{
      const x=Math.cos(a+da*s*1.6)*rad*rr, y=Math.sin(a+da*s*1.6)*rad*rr;
      (i||k)?c.lineTo(x,y):c.moveTo(x,y);
    });
  }
  c.closePath();
}
function drawCog(c,x,y,rad,n,rot,c1,c2){
  c.save(); c.translate(x,y); c.rotate(rot);
  cogPath(c,rad,n); c.fillStyle=c1; c.fill(); c.lineWidth=Math.max(1,rad*.08); c.lineJoin='round'; c.strokeStyle='#2a1708'; c.stroke();
  c.fillStyle='#2a1708'; c.beginPath(); c.arc(0,0,rad*.3,0,TAU); c.fill();   // axle hole
  c.strokeStyle=c2; c.lineWidth=Math.max(1,rad*.1); c.beginPath(); c.arc(0,0,rad*.55,0,TAU); c.stroke();
  c.restore();
}
// numerals and ring are pre-rendered once per size and colour pair, so there is no per-frame fillText
const dialCache={};
function dialImg(r,c1,c2){
  const key=Math.round(r)+'|'+c1+'|'+c2; if(dialCache[key]) return dialCache[key];
  const S=4, N=Math.ceil(r*1.5*S), cn=document.createElement('canvas'); cn.width=cn.height=N;
  const g=cn.getContext('2d'); g.translate(N/2,N/2); g.scale(S,S);
  g.fillStyle='rgba(28,16,6,.62)'; g.beginPath(); g.arc(0,0,r*.72,0,TAU); g.arc(0,0,r*.5,0,TAU,true); g.fill();
  g.strokeStyle=shade(c1,.35); g.lineWidth=r*.025; g.beginPath(); g.arc(0,0,r*.72,0,TAU); g.stroke();
  g.beginPath(); g.arc(0,0,r*.5,0,TAU); g.stroke();
  g.fillStyle='#f6e6b8'; g.textAlign='center'; g.textBaseline='middle'; g.font=`700 ${r*.14}px Georgia,'Times New Roman',serif`;
  for(let i=0;i<12;i++){const a=i/12*TAU; g.fillText(ROMAN[i],Math.sin(a)*r*.61,-Math.cos(a)*r*.61);}
  dialCache[key]=cn; return cn;
}
// k: {ang (body angle), phase:'wind'|'over'|'burn', hand (long hand, radians clockwise from 12), hr (short hand)}
function drawClock(c,r,c1,c2,parts,k){
  const ph=k.phase||'wind';
  c.save();
  if(ph==='over'){c.shadowColor='#5ff3ff'; c.shadowBlur=22;}
  c.fillStyle='#24160a'; c.beginPath(); c.arc(0,0,r*.86,0,TAU); c.fill(); c.restore();
  for(let i=0;i<CW_N;i++){
    c.save(); c.rotate(i/CW_N*TAU);
    if(!parts||parts[i].alive) drawCogTooth(c,r,i,c1,c2);
    else {
      c.fillStyle='#120a04'; c.beginPath();
      c.moveTo(r*.82,-r*.17); c.lineTo(r*.9,-r*.06); c.lineTo(r*.87,r*.06); c.lineTo(r*.82,r*.17); c.closePath(); c.fill();
    }
    c.restore();
  }
  c.lineWidth=r*.05; c.strokeStyle=c2; c.beginPath(); c.arc(0,0,r*.82,0,TAU); c.stroke();
  const g=c.createRadialGradient(-r*.2,-r*.2,r*.05,0,0,r*.76);   // brass plate
  g.addColorStop(0,shade(c1,.35)); g.addColorStop(1,shade(c1,-.5));
  c.fillStyle=g; c.beginPath(); c.arc(0,0,r*.76,0,TAU); c.fill();
  c.lineWidth=r*.035; c.strokeStyle='#2a1708'; c.stroke();
  c.strokeStyle='rgba(30,16,4,.8)'; c.lineWidth=Math.max(.8,r*.018); c.beginPath();   // minute ticks on the rotating rim
  for(let i=0;i<60;i++){const a=i/60*TAU, l=i%5?.045:.1, ca=Math.cos(a), sa=Math.sin(a); c.moveTo(ca*r*.74,sa*r*.74); c.lineTo(ca*r*(.74-l),sa*r*(.74-l));}
  c.stroke();
  // meshing cogs counter-rotate against the body at gear ratios
  const a=k.ang||0;
  drawCog(c,0,0,r*.27,10,-a*1.6,shade(c2,.1),c1);
  for(let i=0;i<3;i++){
    const ba=i*TAU/3+Math.PI/6;
    drawCog(c,Math.cos(ba)*r*.375,Math.sin(ba)*r*.375,r*.13,7,a*2.3*(i%2?1:-1)+i,shade(c1,-.1),c2);
  }
  // dial and hands stay upright however fast the rim spins
  c.save(); c.rotate(-a);
  const D=r*1.5; c.drawImage(dialImg(r,c1,c2),-D/2,-D/2,D,D);
  const cool=ph==='over'?'#7ff8ff':(ph==='burn'?'#7a5a38':'#fff3c4');
  c.strokeStyle='#1a0f05'; c.lineCap='round';
  for(const [ang,len,w] of [[k.hr||0,.4,.06],[k.hand||0,.63,.04]]){
    c.save(); c.rotate(ang);
    c.lineWidth=r*(w+.03); c.beginPath(); c.moveTo(0,r*.07); c.lineTo(0,-r*len); c.stroke();
    c.strokeStyle=cool; c.lineWidth=r*w; c.beginPath(); c.moveTo(0,r*.07); c.lineTo(0,-r*len); c.stroke();
    c.fillStyle=cool; c.beginPath(); c.moveTo(0,-r*(len+.07)); c.lineTo(r*.04,-r*len); c.lineTo(-r*.04,-r*len); c.closePath(); c.fill();
    c.restore(); c.strokeStyle='#1a0f05';
  }
  c.save(); if(ph==='over'){c.shadowColor='#5ff3ff'; c.shadowBlur=12;}
  c.fillStyle=ph==='over'?'#ffffff':c1; c.beginPath(); c.arc(0,0,r*.07,0,TAU); c.fill(); c.restore();
  c.restore();
  if(ph==='burn'){c.fillStyle='rgba(10,5,0,.4)'; c.beginPath(); c.arc(0,0,r*.98,0,TAU); c.fill();}   // dimmed brass
}
// fake wind-up for the select preview and menu backdrop so the hands tick
function previewClk(t){
  const tt=t%12, tick=Math.floor(tt), f=tt-tick;
  return {phase:'wind',hand:tick/12*TAU+Math.sin(f*16)*Math.exp(-f*6)*.3,hr:tt/12*TAU};
}
// simplified silhouette (rim and cogs, no numerals) used for the Sandevistan afterimages
function drawGhost(c,r,ang,col){
  c.save(); c.rotate(ang);
  c.fillStyle=col; c.beginPath(); c.arc(0,0,r*.8,0,TAU); c.fill();
  for(let i=0;i<CW_N;i++){c.save(); c.rotate(i/CW_N*TAU); polyPath(c,cogToothPts(r)); c.fill(); c.restore();}
  c.restore();
}
function drawGhosts(c,f){
  if(!f.ghosts.length) return;
  c.save(); c.globalCompositeOperation='lighter';
  for(const gh of f.ghosts){
    c.globalAlpha=.34*(1-gh.age/CW_GHOST_LIFE);
    c.save(); c.translate(gh.x,gh.y); drawGhost(c,f.r,gh.ang,gh.k%2?'#5ff3ff':'#ffc94d'); c.restore();
  }
  c.restore();
}
/* ---- Scrap-King: rusted steel core, hazard-striped magnetic plates, amber induction coil ---- */
const SK_N=8, SK_W=TAU/SK_N/2*.86;
function platePts(r){return polar([[-SK_W,.78],[-SK_W*.82,1],[SK_W*.82,1],[SK_W,.78]],r);}
function drawPlate(c,r,i,c1,c2){
  const p=platePts(r);
  c.save(); polyPath(c,p); c.fillStyle='#e8a90c'; c.fill(); c.clip();
  c.rotate(.75); c.fillStyle='#17120c';
  for(let k=-8;k<8;k++) c.fillRect(k*r*.2,-r*1.2,r*.1,r*2.4);   // hazard stripes
  c.restore();
  polyPath(c,p); c.fillStyle='rgba(90,40,12,.22)'; c.fill();   // rust wash
  c.lineWidth=r*.04; c.lineJoin='round'; c.strokeStyle='#0d0a07'; polyPath(c,p); c.stroke();
}
let rustPat=null;
function rustPattern(c){
  if(!rustPat){
    const cn=document.createElement('canvas'); cn.width=cn.height=64; const g=cn.getContext('2d');
    for(let i=0;i<170;i++){g.fillStyle=Math.random()<.5?'rgba(160,74,26,.38)':'rgba(18,9,4,.38)'; g.fillRect(rand(0,64),rand(0,64),rand(1,3.2),rand(1,3.2));}
    rustPat=c.createPattern(cn,'repeat');
  }
  return rustPat;
}
// k: {n (ring pieces), cap (ring capacity), pulse (0..1 blast flash), t}
function drawScrap(c,r,c1,c2,parts,k){
  const n=k.n==null?5:k.n, cap=k.cap||SK_N, f=n/cap, t=k.t||0;
  const glow=clamp(.4+.35*f+.5*(k.pulse||0)+.12*Math.sin(t*7),0,1.2);
  c.fillStyle='#2a2019'; c.beginPath(); c.arc(0,0,r*.86,0,TAU); c.fill();
  for(let i=0;i<SK_N;i++){
    c.save(); c.rotate(i/SK_N*TAU);
    if(!parts||parts[i].alive) drawPlate(c,r,i,c1,c2);
    else{   // empty socket where a stabilizer plate was torn off
      c.fillStyle='#120c08'; c.beginPath();
      c.moveTo(r*.8,-r*.22); c.lineTo(r*.92,-r*.14); c.lineTo(r*.92,r*.14); c.lineTo(r*.8,r*.22); c.closePath(); c.fill();
    }
    c.restore();
  }
  const g=c.createRadialGradient(-r*.2,-r*.2,r*.05,0,0,r*.74);   // rusted steel core
  g.addColorStop(0,shade(c1,.15)); g.addColorStop(1,shade(c1,-.62));
  c.fillStyle=g; c.beginPath(); c.arc(0,0,r*.74,0,TAU); c.fill();
  c.fillStyle=rustPattern(c); c.fill();
  c.lineWidth=r*.045; c.strokeStyle='#0d0a07'; c.stroke();
  c.fillStyle='#1b130e';
  for(let i=0;i<SK_N;i++){const a=(i+.5)/SK_N*TAU; c.beginPath(); c.arc(Math.cos(a)*r*.64,Math.sin(a)*r*.64,r*.035,0,TAU); c.fill();}   // bolts
  for(let j=0;j<3;j++){   // copper induction windings
    c.strokeStyle=j%2?'#7a3d1c':'#d98b4a'; c.lineWidth=r*.055;
    c.beginPath(); c.arc(0,0,r*(.5-j*.09),0,TAU); c.stroke();
  }
  c.save(); c.shadowColor=c2; c.shadowBlur=8+24*glow;
  const g2=c.createRadialGradient(0,0,0,0,0,r*.21);
  g2.addColorStop(0,'#fff6d0'); g2.addColorStop(.5,c2); g2.addColorStop(1,shade(c2,-.55));
  c.fillStyle=g2; c.beginPath(); c.arc(0,0,r*.21,0,TAU); c.fill(); c.restore();
}
// faint field markings: the ring's orbit path and the edge of the magnet's reach
function drawField(c,k,t){
  const sk=k.sk, a=.08+.22*(sk.ring.length/Math.max(1,k.skCap()))+.5*sk.pulse;
  c.save(); c.translate(k.x,k.y); c.rotate(t*.8);
  c.strokeStyle=rgba(k.c2,a); c.lineWidth=2; c.setLineDash([6,10]);
  c.beginPath(); c.arc(0,0,k.r+SK_RING,0,TAU); c.stroke();
  c.rotate(-t*1.5); c.strokeStyle=rgba(k.c2,.05+.08*(sk.magT>0?0:1)); c.setLineDash([3,16]);
  c.beginPath(); c.arc(0,0,SK_MAG*(.97+.03*Math.sin(t*3)),0,TAU); c.stroke();
  c.restore();
}
const CRACKS=[[.4,.9],[1.7,.7],[3.1,.95],[4.3,.6],[5.5,.8],[2.4,.55]];
function drawCracks(c,r,hp){
  if(hp>.66) return;
  const n=Math.min(CRACKS.length,Math.ceil((1-hp)/.66*CRACKS.length));
  c.strokeStyle='rgba(0,0,0,.7)'; c.lineWidth=Math.max(1.2,r*.035); c.lineCap='round';
  for(let i=0;i<n;i++){
    const[a,l]=CRACKS[i]; const x=Math.cos(a),y=Math.sin(a);
    c.beginPath(); c.moveTo(x*r*.15,y*r*.15);
    c.lineTo(x*r*l*.5+y*r*.08,y*r*l*.5-x*r*.08);
    c.lineTo(x*r*l,y*r*l); c.stroke();
  }
}
// impact welts: a hot gouge that cools from white to orange to dull red, then stays as a dark dent.
// Drawn inside the rotated body so the marks turn with it. Purely visual.
function drawScars(c,r,scars){
  if(!scars||!scars.length) return;
  c.save();
  c.beginPath(); c.arc(0,0,r*.98,0,TAU); c.clip();
  for(const s of scars){
    const len=r*s.s, wid=r*s.s*.42;
    c.save(); c.rotate(s.a); c.translate(r*.9,0);
    c.fillStyle=`rgba(0,0,0,${.5-.15*s.heat})`;
    c.beginPath(); c.ellipse(0,0,wid,len,0,0,TAU); c.fill();                 // the dent
    c.strokeStyle='rgba(255,255,255,.16)'; c.lineWidth=Math.max(1,r*.025);   // lit rim on the inner side
    c.beginPath(); c.ellipse(0,0,wid,len,0,Math.PI*.6,Math.PI*1.4); c.stroke();
    if(s.heat>0.01){
      const h=s.heat, a=Math.pow(h,.7);
      const col=`${255},${Math.round(70+170*h)},${Math.round(20+160*h*h)}`;
      const gr=c.createRadialGradient(0,0,0,0,0,len*1.7);
      gr.addColorStop(0,`rgba(${col},${.95*a})`); gr.addColorStop(1,`rgba(${col},0)`);
      c.globalCompositeOperation='lighter'; c.fillStyle=gr;
      c.beginPath(); c.arc(0,0,len*1.7,0,TAU); c.fill();
    }
    c.restore();
  }
  c.restore();
}
function drawTop(c,o){
  const{x,y,r,angle,c1,c2}=o; const hp=o.hp==null?1:o.hp, rage=o.rage||0, flash=o.flash||0;
  c.save();
  c.fillStyle='rgba(0,0,0,.35)'; c.beginPath(); c.ellipse(x+r*.12,y+r*.22,r*1.02,r*.95,0,0,TAU); c.fill();
  // below 25% HP the drawn body also jitters off-centre and tilts. Visual only: x, y and r are untouched.
  const bent=clamp((.25-hp)/.25,0,1), t=o.t||0;
  const wob=(1-hp)*(1-hp)*r*.07+bent*r*.035;
  c.translate(x+Math.sin(t*23)*wob,y+Math.cos(t*19)*wob);
  c.rotate(angle+Math.sin(t*31)*.03*bent);
  if(o.id==='bigboy') drawBig(c,r,c1,c2,rage,o.parts);
  else if(o.id==='clockwork') drawClock(c,r,c1,c2,o.parts,{ang:angle,phase:o.clk&&o.clk.phase,hand:o.clk&&o.clk.hand,hr:o.clk&&o.clk.hr});
  else if(o.id==='scrapking') drawScrap(c,r,c1,c2,o.parts,{n:o.sk&&o.sk.n,cap:o.sk&&o.sk.cap,pulse:o.sk&&o.sk.pulse,t});
  else drawWhirl(c,r,c1,c2,o.parts);
  drawScars(c,r,o.scars);
  drawCracks(c,r,hp);
  c.restore();
  if(flash>0){c.fillStyle=`rgba(255,255,255,${Math.min(1,flash)*.85})`; c.beginPath(); c.arc(x,y,r,0,TAU); c.fill();}
}

/* =====================================================================
   FIGHTER
   ===================================================================== */
class Fighter{
  constructor(def,cfg,idx,x,y){
    this.def=def; this.id=def.id; this.idx=idx; this.name=def.name;
    this.x=x; this.y=y; this.vx=0; this.vy=0; this.r=def.r; this.m=def.m;
    this.maxHp=def.hp; this.hp=def.hp; this.hpLag=def.hp;
    this.c1=cfg.c1; this.c2=cfg.c2; this.ctrl=cfg.ctrl;
    this.angle=rand(0,TAU); this.spin=14;
    this.rage=0; this.flash=0; this.alive=true; this.hitCd=0; this.t=0;
    this.orbit=Math.random()<.5?1:-1; this.orbitT=rand(2,4);
    this.dotAcc=0; this.dotT=.7; this.dotSpark=0;
    this.pull=0; this.emitT=0; this.trailT=0;
    this.proxy=null; this.shrapCd=0;
    // wear feedback (visual / timing only, never touches hitboxes or damage maths)
    this.scars=[]; this.stallT=0; this.smokeT=0; this.arcT=rand(.1,.3); this.lastStand=false;
    const N=def.parts;
    this.parts=Array.from({length:N},(_,i)=>({a:i/N*TAU,alive:true}));
    // time dilation: ts is this fighter's own time scale (1 normally, CW_SLOW while a rival is in Overdrive)
    this.ts=1;
    // Clockwork only: tick cycle state machine. hand/hr are the drawn hands (seconds-style and hour-style)
    this.clk=this.id==='clockwork'?{cycle:1,phase:'wind',tick:0,t:0,hand:0,hv:0,hr:0,gT:0,sT:0,running:false,run:0,gt:rand(.6,1.2)}:null;
    this.ghosts=[];
    // collision / AI state
    this.steerT=0; this.sepCd=0;                       // post-hit steering dampener, pair separation cooldown
    this.bank=null; this.bankCd=rand(1.5,3); this.bankK=0;   // Big Boy wall-bank slingshot
    this.cwDir=1; this.cwDirT=0;                       // Clockwork's rim-orbit direction and its flip hysteresis
    // Scrap-King only: the orbiting scrap ring (Matter bodies in gd.state 'captured'), magnet and blast timers
    this.shredCd=0;
    this.sk=this.id==='scrapking'?{ring:[],ang:rand(0,TAU),blastT:rand(3.5,5),magT:0,fallT:2,fallN:0,arcT:.3,planT:0,tgt:null,slam:false,pulse:0,pulling:false}:null;
  }
  skCap(){return this.parts.length-this.lostCount();}   // each lost magnetic plate shrinks the swarm by one
  // where to aim at rival o: its position plus its (real-time) velocity times a lookahead, kept inside the arena
  lead(o,k){
    const d=Math.hypot(o.x-this.x,o.y-this.y), la=clamp(d/Math.max(this.maxSpeed(),150),.08,k);
    let x=o.x+o.vx*o.ts*la, y=o.y+o.vy*o.ts*la; const c=Math.hypot(x,y), lim=R-o.r;
    if(c>lim){x*=lim/c; y*=lim/c;}
    return [x,y];
  }
  cwCfg(){return CW_CYCLES[Math.min(this.clk.cycle,CW_CYCLES.length)-1];}
  cwPhase(){return this.clk?this.clk.phase:null;}
  // Clockwork's tick cycle. Runs once per sim tick on real time, so dilation never stretches its own timers.
  clockStep(dt,g){
    const c=this.clk, cfg=this.cwCfg();
    for(let i=this.ghosts.length-1;i>=0;i--){this.ghosts[i].age+=dt; if(this.ghosts[i].age>CW_GHOST_LIFE) this.ghosts.splice(i,1);}
    if(g.over){ if(c.phase!=='wind'){c.phase='wind'; c.t=0;} return; }   // the match is decided: no more dilation or boost
    c.t+=dt;
    // AI gait: alternate walk and run during wind-up. c.run glides 0..1, so it never stops dead between bursts.
    if(c.phase==='wind'){
      c.gt-=dt;
      if(c.gt<=0){c.running=!c.running; c.gt=c.running?rand(.8,1.1):rand(1.1,1.6);}
    } else {c.running=true; c.gt=0;}
    c.run+=((c.running?1:0)-c.run)*Math.min(1,dt*6);
    if(c.phase==='wind'){
      if(c.t>=cfg.iv){
        c.t-=cfg.iv; c.tick++;
        if(c.tick>=cfg.ticks) this.startOverdrive(g);
        else{
          const ci=Math.min(c.cycle,CW_CYCLES.length)-1;
          SFX.tick(1+.1*ci+.08*c.tick/cfg.ticks,c.tick%2);
          const a=rand(0,TAU);
          addSpark(g,this.x+Math.cos(a)*this.r,this.y+Math.sin(a)*this.r,Math.cos(a)*90,Math.sin(a)*90,.2,'#ffd98a',1.4,true);
        }
      }
      if(c.phase==='wind') c.hr=Math.min(TAU,TAU*(c.tick+c.t/cfg.iv)/cfg.ticks);
    } else if(c.phase==='over'){
      c.hr=TAU*(1-c.t/CW_OVER);   // both hands race backward as a countdown
      c.gT-=dt;
      if(c.gT<=0){
        c.gT=.025; this.ghosts.push({x:this.x,y:this.y,ang:this.angle,age:0,k:c.sT++});
        if(this.ghosts.length>CW_GHOST_MAX) this.ghosts.shift();
        g.parts.push({k:'dot',x:this.x+rand(-6,6),y:this.y+rand(-6,6),vx:rand(-40,40),vy:rand(-40,40),life:.35,max:.35,
          col:c.sT%2?'#5ff3ff':'#ffd166',size:rand(2,3.5),rt:true});
      }
      if(c.t>=CW_OVER) this.startBurnout(g);
    } else { // burnout: the hands sag and the motor sputters
      c.hr+=(Math.PI-c.hr)*Math.min(1,dt*3);
      if(Math.random()<dt*16){
        const a=rand(0,TAU);
        addSpark(g,this.x+Math.cos(a)*this.r*.9,this.y+Math.sin(a)*this.r*.9,Math.cos(a)*rand(40,150),Math.sin(a)*rand(40,150)-30,rand(.15,.35),Math.random()<.5?'#ffb347':'#fff3c4',rand(1,2));
      }
      if(Math.random()<dt*5) g.parts.push({k:'smoke',x:this.x+rand(-1,1)*this.r*.5,y:this.y+rand(-1,1)*this.r*.5,vx:rand(-14,14),vy:-rand(20,45),
        life:1,max:1,size:this.r*rand(.12,.18),al:.2,col:'#d5dbe5'});   // steam
      if(c.t>=cfg.burn){c.cycle++; c.phase='wind'; c.tick=0; c.t=0;}
    }
    // long hand: a spring that overshoots on each tick; locked to the countdown in Overdrive
    if(c.phase==='over'){c.hand=c.hr; c.hv=0;}
    else{
      const burn=c.phase==='burn', tgt=burn?Math.PI:c.tick/cfg.ticks*TAU, kk=burn?18:240, dm=burn?5:16;
      c.hv+=((tgt-c.hand)*kk-c.hv*dm)*dt; c.hand+=c.hv*dt;
    }
  }
  startOverdrive(g){
    const c=this.clk; c.phase='over'; c.t=0; c.hand=c.hr=TAU; c.hv=0; c.gT=0;
    SFX.bellChime();
    addRing(g,this.x,this.y,this.r*.6,this.r*5,.6,'#5ff3ff',5,true);
    addRing(g,this.x,this.y,this.r*.4,this.r*3.2,.45,'#ffd166',3,true);
    addText(g,this.x,this.y-this.r-26,'OVERDRIVE','#7ff8ff',22,true);
    for(let i=0;i<30;i++){const a=rand(0,TAU),s=rand(160,460); addSpark(g,this.x,this.y,Math.cos(a)*s,Math.sin(a)*s,rand(.25,.6),Math.random()<.5?'#5ff3ff':'#ffd166',rand(1,2.6),true);}
    g.shake=Math.max(g.shake,10); hitStop(g,HITSTOP.massive);
  }
  startBurnout(g){
    const c=this.clk, cfg=this.cwCfg(); c.phase='burn'; c.t=0; c.hv=0;
    SFX.gearGroan(cfg.burn);
    addText(g,this.x,this.y-this.r-22,'BURNOUT','#ff9a5a',20);
    for(let i=0;i<14;i++){const a=rand(0,TAU),s=rand(80,260); addSpark(g,this.x,this.y,Math.cos(a)*s,Math.sin(a)*s,rand(.2,.5),'#ffb347',rand(1,2.2));}
  }
  hitCdTime(){return this.clk&&this.clk.phase==='over'?CW_OVER_HITCD:.35;}
  // worldAng is the direction of the hit; it is stored relative to the body so the mark turns with it
  addScar(worldAng,size,heat){
    let a=worldAng-this.angle; a=Math.atan2(Math.sin(a),Math.cos(a));
    this.scars.push({a,s:size,heat:heat==null?1:heat});
    if(this.scars.length>SCAR_MAX) this.scars.shift();
  }
  // motor stall: spin collapses to 15% then revs back up with an ease-out over STALL_TIME
  stallFactor(){
    if(this.stallT<=0) return 1;
    const u=1-this.stallT/STALL_TIME;
    return .15+.85*(1-Math.pow(1-u,3));
  }
  aliveFrac(){return this.parts.filter(p=>p.alive).length/this.parts.length;}
  lostCount(){return this.parts.filter(p=>!p.alive).length;}
  auraR(){return AURA*(.62+.38*this.aliveFrac());}
  fieldPow(){return .45+.55*this.aliveFrac();}
  detachPart(g,cang,fx){
    const alive=this.parts.filter(p=>p.alive); if(!alive.length) return false;
    let pick;
    if(cang==null) pick=alive[(Math.random()*alive.length)|0];
    else{
      let best=1e9;
      for(const p of alive){
        const d=Math.abs(Math.atan2(Math.sin(p.a+this.angle-cang),Math.cos(p.a+this.angle-cang)));
        if(d<best){best=d;pick=p;}
      }
    }
    pick.alive=false;
    const pa=pick.a+this.angle, ca=Math.cos(pa), sa=Math.sin(pa);
    const px=this.x+ca*this.r*.92, py=this.y+sa*this.r*.92;
    const out=rand(200,440), tan=this.spin*this.r*.55*rand(.6,1);
    const kind=this.def.kind;
    const pts=kind==='tooth'?toothPts(this.r):(kind==='cogtooth'?cogToothPts(this.r):(kind==='plate'?platePts(this.r):bladePts(this.r)));
    // becomes a real Matter body; it ignores its former owner for a moment so it can fly clear
    spawnPiece(g,pts,this.x,this.y,pa,
      this.vx*.5+ca*out-sa*tan, this.vy*.5+sa*out+ca*tan, rand(-16,16),
      {kind,idx:this.parts.indexOf(pick),r:this.r,c1:this.c1,c2:this.c2,owner:this.idx,shrap:true,noCapT:1.2},   // noCapT: Scrap-King's magnet leaves a fresh chip alone for a moment
      {density:kind==='blade'?.003:.004,ghost:.4,noOwner:true});
    if(fx){
      for(let i=0;i<18;i++){const a=rand(0,TAU),sp=rand(120,440); addSpark(g,px,py,Math.cos(a)*sp,Math.sin(a)*sp,rand(.2,.55),Math.random()<.5?'#fff3c4':this.c2,rand(1,2.6));}
      addRing(g,px,py,3,36,.25,this.c2,3);
      g.shake=Math.max(g.shake,5); hitStop(g,HITSTOP.chip); SFX.chip();
    }
    return true;
  }
  detachAll(g){while(this.detachPart(g,null,false));}
  // Clockwork's phase multiplier: Overdrive boosts, burnout drags. level picks the stat (speed, accel, spin).
  // gait=true also applies the AI walk/run burst cycle during wind-up (humans keep full control speed)
  cwMul(burn,gait){
    const ph=this.clk.phase;
    if(ph==='over') return CW_OVER_BOOST;
    if(ph==='burn') return burn;
    return gait&&this.ctrl!=='human'?CW_WALK+(1-CW_WALK)*this.clk.run:1;
  }
  maxSpeed(){
    if(this.id==='bigboy') return (110+this.rage*360)*(1+BANK_BOOST*this.bankK);
    if(this.id==='clockwork') return 255*this.cwCfg().boost*this.cwMul(.55,true);
    if(this.id==='scrapking') return 215*(1+BANK_BOOST*this.bankK);
    return 330;
  }
  accel(){
    if(this.id==='bigboy') return (170+this.rage*520)*(1+.25*this.bankK);
    if(this.id==='clockwork') return 900*this.cwCfg().boost*this.cwMul(.5,true);
    if(this.id==='scrapking') return 720*(1+.25*this.bankK);
    return 1000;
  }
  dragK(){
    if(this.id==='bigboy') return .55*(1-.35*this.bankK);
    if(this.id==='clockwork') return this.clk.phase==='burn'?2.7:.9;   // burnout: heavy drag
    if(this.id==='scrapking') return .8*(1-.3*this.bankK);
    return 1.1;
  }
  baseSpin(){
    if(this.id==='bigboy') return 10+this.rage*20;
    if(this.id==='clockwork') return 18*this.cwCfg().boost*this.cwMul(.3);
    if(this.id==='scrapking') return 12;
    return 24;
  }
  contactDamage(impact){
    if(this.id==='bigboy') return impact*0.05*(1+this.rage*3)*(.55+.45*this.aliveFrac());
    if(this.id==='scrapking') return impact*0.04*(.55+.45*this.aliveFrac());   // lost plates weaken the hit
    if(this.id==='clockwork') return impact*0.035*(.55+.45*this.aliveFrac())*(this.clk.phase==='over'?CW_OVER_DMG:1);   // lost teeth weaken the hit, never the clock
    return 0; // Whirl does no damage by touch
  }
  ai(dt,g){
    const o=g.fighters.find(f=>f!==this&&f.alive); if(!o) return [0,0];
    let dx=o.x-this.x, dy=o.y-this.y; const d=Math.hypot(dx,dy)||1; dx/=d; dy/=d;
    if(this.id==='bigboy') return this.aiBig(o,dx,dy,d,dt);
    if(this.id==='clockwork'){
      // Wind-up and burnout: circle the rim, out of reach. Overdrive: lead the rival and slam, then bank off a wall before burnout.
      if(this.clk.phase!=='over') return this.evade(o,dx,dy,d,dt);
      return this.cwAmbush(o,dx,dy);
    }
    if(this.id==='scrapking') return this.aiScrap(o,dx,dy,d,dt,g);
    return this.aiWhirl(o,dx,dy,d,dt);
  }
  // pick the densest-looking loose scrap (live free pieces and settled records) to reload from. Samples, so it stays cheap.
  scrapTarget(g){
    const pw=g.pw, cand=[];
    const take=(list,isBody)=>{
      const m=list.length; if(!m) return;
      for(let i=0;i<22&&cand.length<44;i++){
        const b=list[(Math.random()*m)|0], s=b.gd.state;
        if(isBody&&((s&&s!=='free')||b.gd.noCapT>0)) continue;
        cand.push(b.position);
      }
    };
    take(pw.bodies,true); take(pw.settled,false);
    let best=null, bs=-1;
    for(const p of cand){
      let nb=0; for(const q of cand) if(Math.hypot(p.x-q.x,p.y-q.y)<120) nb++;
      const sc=(1+nb)/(1+Math.hypot(p.x-this.x,p.y-this.y)/280);
      if(sc>bs){bs=sc; best=p;}
    }
    return best?[best.x,best.y]:null;
  }
  // ride the arena rim toward angle pa (a wall-bank). Returns a steering vector, or null once the bank is over.
  bankStep(dt,pa){
    const b=this.bank; b.t-=dt;
    const dc=Math.hypot(this.x,this.y)||1, th=Math.atan2(this.y,this.x);
    if(b.t<=0||(Math.abs(angDiff(pa,th))<.5&&dc>R*.6)){this.bank=null; this.bankCd=rand(4,6); return null;}
    let wx,wy;
    if(dc>R*.78){ wx=-this.y/dc*b.dir+this.x/dc*.3; wy=this.x/dc*b.dir+this.y/dc*.3; }   // on the rim: ride it
    else{ const a=th+b.dir*.5; wx=Math.cos(a)*(R-this.r)-this.x; wy=Math.sin(a)*(R-this.r)-this.y; }   // shallow approach to the wall
    const l=Math.hypot(wx,wy)||1; return [wx/l,wy/l];
  }
  // Scrap-King: opportunistic scavenger. Reload from the densest floor scrap (banking along the rim to reach it),
  // then, armed with 3+ pieces, close on the rival so the ring faces it and the polarity blast lands at close-to-mid range.
  aiScrap(o,dx,dy,d,dt,g){
    const sk=this.sk, n=sk.ring.length, cap=this.skCap();
    this.bankCd-=dt; sk.planT-=dt;
    const th=Math.atan2(this.y,this.x);
    const armed=n>=3||(n>=2&&sk.blastT<=0);
    const wantScrap=!armed&&n<Math.min(cap,4)&&sk.magT<=0;
    if(wantScrap){
      if(sk.planT<=0){sk.planT=.5; sk.tgt=this.scrapTarget(g);}
      if(sk.tgt){
        const [tx,ty]=sk.tgt, td=Math.hypot(tx-this.x,ty-this.y), tc=Math.hypot(tx,ty), pa=Math.atan2(ty,tx);
        if(!this.bank&&this.bankCd<=0&&td>260&&tc>R*.6) this.bank={t:rand(.7,1.1),dir:angDiff(pa,th)>=0?1:-1};
        if(this.bank){const v=this.bankStep(dt,pa); if(v) return v;}
        const l=td||1, w=Math.sin(this.t*1.9)*.2;
        const ux=(tx-this.x)/l, uy=(ty-this.y)/l;
        return [ux-uy*w,uy+ux*w];
      }
    }
    // armed (or nothing to scavenge): lead-aim at the rival and slam; a wall-bank slam also triggers the blast
    if(!this.bank&&this.bankCd<=0&&armed&&d>(this.r+o.r+SK_RANGE)*1.3){
      this.bank={t:rand(.7,1.1),dir:angDiff(Math.atan2(o.y,o.x),th)>=0?1:-1};
    }
    if(this.bank){const v=this.bankStep(dt,Math.atan2(o.y,o.x)); if(v) return v;}
    const [lx,ly]=this.lead(o,.35); let tx=lx-this.x, ty=ly-this.y; const l=Math.hypot(tx,ty)||1; tx/=l; ty/=l;
    const w=Math.sin(this.t*1.3)*.2;
    return [tx-ty*w,ty+tx*w];
  }
  // Big Boy: lead-aiming chase, plus a wall-bank slingshot when the rival is kiting him from far away.
  aiBig(o,dx,dy,d,dt){
    this.bankCd-=dt;
    const dc=Math.hypot(this.x,this.y)||1, th=Math.atan2(this.y,this.x), ph=Math.atan2(o.y,o.x);
    const closing=-(o.vx*o.ts*dx+o.vy*o.ts*dy);
    if(!this.bank && this.bankCd<=0 && d>(this.r+o.r+230)*1.6 && closing<80){
      this.bank={t:rand(.8,1.2),dir:angDiff(ph,th)>=0?1:-1};
    }
    if(this.bank){
      this.bank.t-=dt;
      const near=Math.abs(angDiff(ph,th))<.5 && dc>R*.6;
      if(this.bank.t<=0||near){this.bank=null; this.bankCd=rand(5,7);}
      else{
        const dir=this.bank.dir; let wx,wy;
        if(dc>R*.78){ wx=-this.y/dc*dir+this.x/dc*.3; wy=this.x/dc*dir+this.y/dc*.3; }   // on the rim: ride it
        else{ const a=th+dir*.5; wx=Math.cos(a)*(R-this.r)-this.x; wy=Math.sin(a)*(R-this.r)-this.y; }   // shallow approach to the wall
        const l=Math.hypot(wx,wy)||1; return [wx/l,wy/l];
      }
    }
    const [lx,ly]=this.lead(o,.45); let tx=lx-this.x, ty=ly-this.y; const l=Math.hypot(tx,ty)||1; tx/=l; ty/=l;
    const w=Math.sin(this.t*1.7)*.25;
    return [tx-ty*w, ty+tx*w];
  }
  // Whirl: circle the rival at close range so it stays inside her burning ring, sidestepping head-on slams.
  aiWhirl(o,dx,dy,d,dt){
    const A=this.auraR(), touch=this.r+o.r;
    const vt=-dy*(o.vx*o.ts-this.vx)+dx*(o.vy*o.ts-this.vy);   // rival's motion around us (along the CCW tangent)
    this.orbitT-=dt;
    if(this.orbitT<=0){this.orbit=Math.abs(vt)>60?Math.sign(vt):-this.orbit; this.orbitT=rand(2,4);}
    const [lx,ly]=this.lead(o,.3); let ux=lx-this.x, uy=ly-this.y; const ud=Math.hypot(ux,uy)||1; ux/=ud; uy/=ud;
    const closing=Math.max(0,-(o.vx*o.ts*dx+o.vy*o.ts*dy));
    const threat=clamp(closing/450+(o.id==='bigboy'&&d<touch+130?o.rage*.6:0),0,1);
    const rr=Math.min(Math.max(touch+34,A*.62)*(1+.35*threat),A*.95);
    const rad=clamp((rr-ud)/50,-1,1);
    let wx=-ux*rad+(-uy)*this.orbit*.9, wy=-uy*rad+ux*this.orbit*.9;
    wx+=-uy*this.orbit*threat*.8; wy+=ux*this.orbit*threat*.8;   // sidestep a charge
    if(o.id==='bigboy' && d<rr*1.15){const th=.4+o.rage*1.2; wx-=dx*th; wy-=dy*th;}
    const dc=Math.hypot(this.x,this.y);
    if(dc>R*.72){const k=(dc-R*.72)/(R*.28)*2; wx-=this.x/dc*k; wy-=this.y/dc*k;}
    const l=Math.hypot(wx,wy)||1; return [wx/l,wy/l];
  }
  // Clockwork in Overdrive: lead-aimed slams; in the last 0.7s bank off the nearest wall so burnout starts with distance.
  cwAmbush(o,dx,dy){
    const c=this.clk, left=CW_OVER-c.t;
    if(left<.7){
      const dc=Math.hypot(this.x,this.y)||1, sp=Math.max(Math.hypot(this.vx,this.vy),100);
      if((R-dc-this.r)/sp<left){
        const th=Math.atan2(this.y,this.x), ph=Math.atan2(o.y,o.x), dir=angDiff(th,ph)>=0?1:-1;   // slide to the side away from the rival
        const a=th+dir*.35, wx=Math.cos(a)*R-this.x, wy=Math.sin(a)*R-this.y, l=Math.hypot(wx,wy)||1;
        return [wx/l,wy/l];
      }
      return [-dx,-dy];
    }
    const [lx,ly]=this.lead(o,.25), tx=lx-this.x, ty=ly-this.y, l=Math.hypot(tx,ty)||1;
    return [tx/l,ty/l];
  }
  // Clockwork's defensive AI: keep a safe gap from the rival (wider for Big Boy and a rival's gravity field),
  // back away harder when the rival is closing in, strafe toward the arena centre, and slide along the wall instead of
  // getting pinned. (dx,dy) is the unit vector to the rival, d the distance.
  // Blends away-from-rival steering with a tangential orbit of the arena rim, held at ~0.68R by a radial spring,
  // so it circles smoothly instead of backing into a wall. The orbit direction heads away from the rival (flips at most every 1.5s).
  evade(o,dx,dy,d,dt){
    const px=this.x, py=this.y, dc=Math.hypot(px,py)||1, nx=px/dc, ny=py/dc;
    this.cwDirT-=dt||0;
    const awayCcw=(-dx)*(-ny)+(-dy)*nx;   // away-vector component along the CCW rim tangent
    if(this.cwDirT<=0 && Math.abs(awayCcw)>.25){
      const nd=awayCcw>0?1:-1; if(nd!==this.cwDir){this.cwDir=nd; this.cwDirT=1.5;}
    }
    const safe=this.r+o.r+(o.id==='whirl'?o.auraR():o.id==='bigboy'?170+o.rage*140:o.id==='scrapking'?SK_RING+150:130);   // Scrap-King's ring adds reach
    const closing=Math.max(0,-(o.vx*o.ts*dx+o.vy*o.ts*dy));
    const threat=clamp((safe-d)/safe,0,1)+(d<safe*1.6?clamp(closing/600,0,.6):0);
    let ax=-dx, ay=-dy;
    const wall=clamp((dc-R*.7)/(R*.25),0,1);
    if(wall>0){const ou=ax*nx+ay*ny; if(ou>0){ax-=nx*ou*wall; ay-=ny*ou*wall;}}   // last resort: slide along the wall
    const radial=clamp((R*.68-dc)/(R*.3),-1.2,1.2);
    const orb=.9*(1-.5*Math.min(1,threat))+.2, aw=threat*1.3;
    const wx=ax*aw+(-ny)*this.cwDir*orb+nx*radial*.9;
    const wy=ay*aw+nx*this.cwDir*orb+ny*radial*.9;
    const l=Math.hypot(wx,wy)||1, mag=Math.min(1,.45+threat);
    return [wx/l*mag,wy/l*mag];
  }
  // scars cool, smoke below 50% HP (ramping in), electrical arcs below 25%
  wear(dt,g,hpF){
    for(const s of this.scars) s.heat=Math.max(0,s.heat-dt/SCAR_COOL);
    if(hpF<.5){
      const k=clamp((.5-hpF)/.5,0,1);
      this.smokeT-=dt;
      if(this.smokeT<=0){
        this.smokeT=.16-.11*k;
        const a=rand(0,TAU), d=rand(0,this.r*.25), life=rand(.9,1.5);
        g.parts.push({k:'smoke',x:this.x+Math.cos(a)*d,y:this.y+Math.sin(a)*d,vx:rand(-16,16),vy:-rand(18,42),
          life,max:life,size:this.r*rand(.14,.2),al:.22+.3*k});
      }
    }
    if(hpF<.25){
      this.arcT-=dt;
      if(this.arcT<=0){
        this.arcT=rand(.15,.5);
        const pts=[[rand(-.2,.2)*this.r,rand(-.2,.2)*this.r]], a=rand(0,TAU), n=rand(3,5)|0;
        const ex=Math.cos(a)*this.r*rand(.95,1.15), ey=Math.sin(a)*this.r*rand(.95,1.15);
        for(let i=1;i<n;i++){
          const u=i/n, j=this.r*.22*(1-u*.4);
          pts.push([ex*u+rand(-j,j),ey*u+rand(-j,j)]);
        }
        pts.push([ex,ey]);
        g.parts.push({k:'arc',f:this,pts,life:.09,max:.09,col:Math.random()<.5?'#ff3b3b':'#5ab0ff'});
        if(Math.random()<.7) addSpark(g,this.x+ex,this.y+ey,Math.cos(a)*rand(60,200)+rand(-60,60),Math.sin(a)*rand(60,200)+rand(-60,60),rand(.15,.35),Math.random()<.5?'#ff5a5a':'#8cc8ff',rand(1,2));
      }
    }
  }
  step(dt,g){
    this.t+=dt; this.hitCd=Math.max(0,this.hitCd-dt); this.flash=Math.max(0,this.flash-dt*5);
    this.shrapCd=Math.max(0,this.shrapCd-dt); this.sepCd=Math.max(0,this.sepCd-dt); this.shredCd=Math.max(0,this.shredCd-dt);
    const ai=this.ctrl!=='human';
    this.steerT=Math.max(0,this.steerT-dt);
    this.bankK+=((this.bank?1:0)-this.bankK)*Math.min(1,dt*5);
    if(this.id==='bigboy') this.rage=Math.min(1,this.rage+dt/RAGE_TIME);
    let ix=0,iy=0;
    if(this.ctrl==='human'){
      const k=KEYMAP[this.idx];
      ix=(keys[k.r]?1:0)-(keys[k.l]?1:0); iy=(keys[k.d]?1:0)-(keys[k.u]?1:0);
    } else [ix,iy]=this.ai(dt,g);
    const il=Math.hypot(ix,iy); if(il>1){ix/=il;iy/=il;}
    // post-hit dampener (AI only): almost no steering at the hit, easing back in over STEER_T
    const damp=ai&&this.steerT>0;
    if(damp){const sm=.12+.88*Math.pow(1-this.steerT/STEER_T,2); ix*=sm; iy*=sm;}
    const a=this.accel();
    this.vx+=ix*a*dt; this.vy+=iy*a*dt;
    // the arena is a shallow bowl: everything drifts to the middle
    this.vx-=this.x*.18*dt; this.vy-=this.y*.18*dt;
    const drag=Math.exp(-this.dragK()*dt);
    this.vx*=drag; this.vy*=drag;
    const sp=Math.hypot(this.vx,this.vy), mx=this.maxSpeed();
    if(sp>mx){const ns=mx+(sp-mx)*Math.exp(-(damp?1.2:3)*dt); this.vx*=ns/sp; this.vy*=ns/sp;}
    this.x+=this.vx*dt; this.y+=this.vy*dt;
    // wall
    const dc=Math.hypot(this.x,this.y);
    if(dc+this.r>R){
      const nx=this.x/dc, ny=this.y/dc;
      this.x=nx*(R-this.r); this.y=ny*(R-this.r);
      // grinding along the wall: drives the scrape sound and a stream of sparks
      const vt=-this.vx*ny+this.vy*nx;
      if(Math.abs(vt)>70){
        g.scrape=Math.max(g.scrape,clamp(Math.abs(vt)/320,0,1));
        if(Math.random()<dt*26) addSpark(g,nx*R,ny*R,-ny*Math.sign(vt)*rand(120,280)-nx*rand(20,80),nx*Math.sign(vt)*rand(120,280)-ny*rand(20,80),rand(.15,.35),Math.random()<.5?'#ffb347':'#fff3c4',rand(1,2));
      }
      const vn=this.vx*nx+this.vy*ny;
      if(vn>0){
        if(this.sk&&vn>300&&this.sk.ring.length>=2) this.sk.slam=true;   // heavy wall slam: reverse polarity right now
        this.vx-=E_WALL*vn*nx; this.vy-=E_WALL*vn*ny;
        if(vn>140){
          const px=nx*R, py=ny*R, cnt=clamp(vn/25,3,14)|0;
          for(let i=0;i<cnt;i++){
            const ta=Math.atan2(ny,nx)+Math.PI/2*(Math.random()<.5?1:-1)+rand(-.9,.9);
            const s=rand(120,320);
            addSpark(g,px,py,Math.cos(ta)*s-nx*rand(40,120),Math.sin(ta)*s-ny*rand(40,120),rand(.15,.4),Math.random()<.5?'#ffb347':'#fff3c4',rand(1,2.2));
          }
        }
      }
    }
    const hpF=this.hp/this.maxHp;
    this.stallT=Math.max(0,this.stallT-dt);
    this.spin=this.baseSpin()*(.35+.65*hpF)*this.stallFactor();
    this.angle+=this.spin*dt;
    this.wear(dt,g,hpF);
    // trail particles
    this.trailT-=dt;
    if(this.trailT<=0){
      if(this.id==='bigboy' && this.rage>.3){
        this.trailT=.025;
        const s=Math.hypot(this.vx,this.vy)||1;
        g.parts.push({k:'dot',x:this.x-this.vx/s*this.r*.8+rand(-6,6),y:this.y-this.vy/s*this.r*.8+rand(-6,6),vx:rand(-30,30),vy:rand(-30,30),life:.4,max:.4,col:Math.random()<.5?'#ff7a1a':'#ffd166',size:rand(2,3+this.rage*3)});
      } else if(this.id==='whirl'){
        this.trailT=.04;
        const a=rand(0,TAU);
        g.parts.push({k:'dot',x:this.x+Math.cos(a)*this.r,y:this.y+Math.sin(a)*this.r,vx:Math.cos(a+1.6)*60,vy:Math.sin(a+1.6)*60,life:.45,max:.45,col:this.c2,size:rand(1.5,2.5)});
      }
    }
  }
}

/* =====================================================================
   PARTICLES
   ===================================================================== */
// rt=true: the particle runs on real time and ignores Sandevistan slow-motion (Clockwork's own effects)
function addSpark(g,x,y,vx,vy,life,col,size,rt){g.parts.push({k:'spark',x,y,vx,vy,life,max:life,col,size,rt});}
function addText(g,x,y,txt,col,size,rt){g.parts.push({k:'text',x,y,vx:rand(-15,15),vy:-50,life:.9,max:.9,txt,col,size,rt});}
function addRing(g,x,y,r0,r1,life,col,lw,rt){g.parts.push({k:'ring',x,y,r0,r1,life,max:life,col,lw,rt});}

function impactSparks(g,x,y,nx,ny,impact,cols,heavy){
  const cnt=clamp(impact/2.6,18,130)|0;
  const tx=-ny, ty=nx;
  for(let i=0;i<cnt;i++){
    const side=Math.random()<.5?1:-1, spread=rand(-.7,.7);
    let dx=tx*side+nx*spread, dy=ty*side+ny*spread;
    const l=Math.hypot(dx,dy)||1; dx/=l; dy/=l;
    const s=rand(160,360+impact*1.1);
    const col=Math.random()<.45?'#fff3c4':(Math.random()<.5?'#ffb347':cols[(Math.random()*cols.length)|0]);
    addSpark(g,x,y,dx*s,dy*s,rand(.2,.6),col,rand(1,2.8));
  }
  for(let i=0;i<10;i++){ // slow glowing embers
    const a=rand(0,TAU), s=rand(40,150);
    g.parts.push({k:'dot',x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:rand(.3,.7),max:.7,col:Math.random()<.5?'#ffb347':'#ff7a1a',size:rand(1.5,3)});
  }
  g.parts.push({k:'dot',x,y,vx:0,vy:0,life:.14,max:.14,col:'#ffffff',size:10+Math.min(14,impact*.03)});
  addRing(g,x,y,4,24+impact*.1,.28,'#ffffff',2.5);
  if(heavy) addRing(g,x,y,2,46+impact*.12,.4,cols[0],4);
}

/* =====================================================================
   PHYSICS WORLD (Matter.js): debris, shards, arena wall, fighter proxies
   ---------------------------------------------------------------------
   Hybrid model. Fighters keep their hand-tuned circle physics. Each one
   owns a very heavy Matter "proxy" circle that is teleported onto the
   fighter every substep, so debris gets pushed around by fighters but
   fighters are never pushed by debris.
   Matter velocities are px per 1/60 s (VU), our sim uses px per second.
   ===================================================================== */
const {Engine,Bodies,Body,Composite,Events,Vertices,Sleeping}=Matter;
const CAT={WALL:1,F0:2,F1:4,DEBRIS:8};
const FCAT=[CAT.F0,CAT.F1];
const DEBRIS_MASK=CAT.WALL|CAT.F0|CAT.F1|CAT.DEBRIS;
const VU=60;
const MAX_BODIES=150;       // live pieces before the oldest get baked into the floor
const BAKE_AGE=5;           // seconds a piece must lie still before it is baked
const MAXV=26;              // speed cap in Matter units (about 1560 px/s) to stop tunnelling
const FLOOR_HALF=R+30, FLOOR_S=1.5;
const SETTLED_MAX=600;      // resting pieces kept as wakeable records; only the oldest overflow is baked into the inert floor canvas
const WAKE_BUDGET=12;       // settled pieces that may wake back into Matter bodies per tick
/* Debris body states (gd.state; undefined counts as 'free'):
     free      ordinary loose debris
     captured  in a Scrap-King ring. Never sleeps, never settles, never splits, collides with walls only
     launched  fired by a polarity blast; behaves like free debris but can't be recaptured for a moment, and never hurts its shooter
   A resting piece is turned into a record in pw.settled (not a body) and wakes again when a fighter, Whirl's field or a magnet gets near. */
const SHRAPNEL_MIN=440;     // px/s relative speed before a flying piece hurts
const SPLIT_FIGHTER=450, SPLIT_OTHER=600;
const setVel=(b,vx,vy)=>Body.setVelocity(b,{x:vx/VU,y:vy/VU});
// NOTE: body.velocity / body.speed are per-substep values; Body.getVelocity() normalises to px per 1/60 s
const getVel=b=>Body.getVelocity(b);

function bladePts(r){
  const q=(p0,c,p1,t)=>{const u=1-t;return[u*u*p0[0]+2*u*t*c[0]+t*t*p1[0],u*u*p0[1]+2*u*t*c[1]+t*t*p1[1]];};
  const P0=[.25,-.12],C1=[.8,-.8],P1=[1,.1],C2=[.66,-.2],P2=[.25,.22], out=[];
  for(let i=0;i<=5;i++){out.push(q(P0,C1,P1,i/5));out.push(q(P1,C2,P2,i/5));}
  return out.map(p=>[p[0]*r,p[1]*r]);
}
function polyCentroid(p){
  let a=0,cx=0,cy=0;
  for(let i=0;i<p.length;i++){
    const[x0,y0]=p[i],[x1,y1]=p[(i+1)%p.length],c=x0*y1-x1*y0;
    a+=c; cx+=(x0+x1)*c; cy+=(y0+y1)*c;
  }
  a/=2; if(Math.abs(a)<1e-6) return null;
  return{cx:cx/(6*a),cy:cy/(6*a),area:Math.abs(a)};
}
// convex hull + re-centre on the centroid; (cx,cy) is where that centroid sat in the input frame
function makeShape(local){
  const hull=Vertices.hull(local.map(([x,y])=>({x,y})));
  if(hull.length<3) return null;
  const pts=hull.map(v=>[v.x,v.y]), m=polyCentroid(pts);
  if(!m||m.area<4) return null;
  return{pts:pts.map(([x,y])=>[x-m.cx,y-m.cy]),cx:m.cx,cy:m.cy};
}
function clipHalf(p,nx,ny){ // keep the part of polygon p where dot(point,n)>=0
  const out=[];
  for(let i=0;i<p.length;i++){
    const a=p[i],b=p[(i+1)%p.length],da=a[0]*nx+a[1]*ny,db=b[0]*nx+b[1]*ny;
    if(da>=0) out.push(a);
    if((da>=0)!==(db>=0)){const t=da/(da-db); out.push([a[0]+(b[0]-a[0])*t,a[1]+(b[1]-a[1])*t]);}
  }
  return out;
}

function createWorld(g){
  const engine=Engine.create({enableSleeping:true});
  engine.gravity.x=0; engine.gravity.y=0; engine.gravity.scale=0; // top-down view
  engine.positionIterations=6; engine.velocityIterations=4;
  // the round wall: a ring of thick static slabs, inner face at radius R
  const T=70, N=48, L=2*(R+T/2)*Math.tan(Math.PI/N)*1.08, walls=[];
  for(let i=0;i<N;i++){
    const a=i/N*TAU, rr=R+T/2;
    const w=Bodies.rectangle(Math.cos(a)*rr,Math.sin(a)*rr,L,T,{isStatic:true,angle:a+Math.PI/2,restitution:.6,friction:.2,
      collisionFilter:{category:CAT.WALL,mask:CAT.DEBRIS},label:'wall'});
    w.gd={type:'wall'}; walls.push(w);
  }
  Composite.add(engine.world,walls);
  const floor=document.createElement('canvas');
  floor.width=floor.height=Math.ceil(FLOOR_HALF*2*FLOOR_S);
  const pw={engine,bodies:[],settled:[],hits:[],floor,fctx:floor.getContext('2d'),tick:0,rs:1};
  Events.on(engine,'collisionStart',ev=>{
    for(const p of ev.pairs){
      const a=p.bodyA,b=p.bodyB; if(!a.gd||!b.gd||pw.hits.length>40) continue;
      const va=getVel(a), vb=getVel(b), rel=Math.hypot(va.x-vb.x,va.y-vb.y)*VU*pw.rs;   // rs: slow-motion scale, so dilated debris isn't treated as fast
      if(rel<110) continue;
      const s=p.collision&&p.collision.supports&&p.collision.supports[0];
      pw.hits.push({a,b,rel,x:s?s.x:(a.position.x+b.position.x)/2,y:s?s.y:(a.position.y+b.position.y)/2});
    }
  });
  return pw;
}
function makeProxy(g,f){
  const b=Bodies.circle(f.x,f.y,f.r,{frictionAir:0,friction:0,restitution:.3,label:'fighter',
    collisionFilter:{category:FCAT[f.idx],mask:CAT.DEBRIS}});
  Body.setMass(b,300); Body.setInertia(b,Infinity); b.sleepThreshold=Infinity;
  b.gd={type:'fighter',f}; Composite.add(g.pw.engine.world,b); f.proxy=b;
}
function dropProxy(g,f){ if(f.proxy){Composite.remove(g.pw.engine.world,f.proxy); f.proxy=null;} }

// o: {density, ghost:seconds of reduced collision, noOwner:ignore the owning fighter while ghost,
//     sh:an existing shape to reuse (waking a settled piece: (ox,oy) is then the body position itself)}
function spawnPiece(g,local,ox,oy,rot,vx,vy,vr,gd,o){
  const sh=o.sh||makeShape(local); if(!sh) return null;
  const ca=Math.cos(rot), sa=Math.sin(rot), pw=g.pw;
  const x=o.sh?ox:ox+ca*sh.cx-sa*sh.cy, y=o.sh?oy:oy+sa*sh.cx+ca*sh.cy;
  const b=Body.create({position:{x,y},vertices:sh.pts.map(([px,py])=>({x:px,y:py})),density:o.density,
    restitution:.5,friction:.15,frictionStatic:.6,frictionAir:.025,sleepThreshold:45,label:'debris',
    collisionFilter:{category:CAT.DEBRIS,mask:o.noOwner&&o.ghost?DEBRIS_MASK&~FCAT[gd.owner]:DEBRIS_MASK,group:gd.group||0}});
  Body.setAngle(b,rot); setVel(b,vx,vy); Body.setAngularVelocity(b,vr/VU);
  gd.type='debris'; gd.shape=sh; gd.born=g.time; gd.ghostT=o.ghost||0; gd.hitCd=0; gd.dens=o.density;
  b.gd=gd; Composite.add(pw.engine.world,b); pw.bodies.push(b);
  while(pw.bodies.length>MAX_BODIES){   // over budget: the oldest non-captured piece lies down as a settled record
    const old=pw.bodies.find(q=>q.gd.state!=='captured'); if(!old) break;
    settlePiece(g,old);
  }
  return b;
}
function removeBody(g,b){
  const pw=g.pw, i=pw.bodies.indexOf(b); if(i>=0) pw.bodies.splice(i,1);
  Composite.remove(pw.engine.world,b);
}
function drawPiece(c,b){
  const d=b.gd, sh=d.shape;
  c.save(); c.translate(b.position.x,b.position.y); c.rotate(b.angle);
  if(d.kind==='tooth'){
    c.translate(-sh.cx,-sh.cy); drawTooth(c,d.r,d.idx||0,d.c1,d.c2);
  } else if(d.kind==='cogtooth'){
    c.translate(-sh.cx,-sh.cy); drawCogTooth(c,d.r,d.idx||0,d.c1,d.c2);
  } else if(d.kind==='plate'){
    c.translate(-sh.cx,-sh.cy); drawPlate(c,d.r,d.idx||0,d.c1,d.c2);
  } else if(d.kind==='blade'){
    c.translate(-sh.cx,-sh.cy); bladePath(c,d.r); c.fillStyle=d.c2; c.fill();
    c.lineWidth=d.r*.045; c.lineJoin='round'; c.strokeStyle='#0d0e14'; c.stroke();
  } else {
    polyPath(c,sh.pts); c.fillStyle=d.col; c.fill();
    c.strokeStyle='rgba(0,0,0,.55)'; c.lineWidth=1.3; c.lineJoin='round'; c.stroke();
  }
  c.restore();
}
// stamp a settled record (or body) onto the inert floor canvas. Only the oldest overflow of the settled pile ends up here.
function bakePiece(g,b){
  const c=g.pw.fctx, o=FLOOR_HALF*FLOOR_S;
  c.save(); c.setTransform(FLOOR_S,0,0,FLOOR_S,o,o); drawPiece(c,b); c.restore();
}
// a resting piece stops being a body and becomes a record that stays on the floor and can wake again
function settlePiece(g,b){
  const pw=g.pw, d=b.gd;
  d.state='free'; d.shrap=false; d.shotBy=undefined; d.blast=null; d.hitCd=0; d.noCapT=0;
  pw.settled.push({position:{x:b.position.x,y:b.position.y},angle:b.angle,gd:d});
  removeBody(g,b);
  while(pw.settled.length>SETTLED_MAX) bakePiece(g,pw.settled.shift());
}
function maintainPile(g){
  const bodies=g.pw.bodies;
  for(let i=bodies.length-1;i>=0;i--){
    const b=bodies[i], d=b.gd; if(d.state==='captured') continue;   // an orbiting piece may look slow: never settle it
    if(g.time-d.born>BAKE_AGE&&(b.isSleeping||Body.getSpeed(b)*VU<10)) settlePiece(g,b);
  }
}
// settled pieces wake into real bodies when a moving fighter, Whirl's field or a Scrap-King magnet comes near
function wakeSettled(g){
  const pw=g.pw, S=pw.settled; if(!S.length) return;
  const src=[];
  for(const f of g.fighters){
    if(!f.alive) continue;
    if(Math.hypot(f.vx,f.vy)*f.ts>25) src.push([f.x,f.y,f.r+16]);
    if(f.id==='whirl') src.push([f.x,f.y,f.auraR()*DEBRIS_REACH]);
    if(f.sk&&f.sk.magT<=0&&f.sk.ring.length<f.skCap()) src.push([f.x,f.y,SK_MAG]);
  }
  if(!src.length) return;
  let budget=WAKE_BUDGET;
  for(let i=S.length-1;i>=0&&budget>0;i--){
    const p=S[i];
    for(const [sx,sy,sr] of src){
      const dx=p.position.x-sx, dy=p.position.y-sy;
      if(dx*dx+dy*dy<sr*sr){
        S.splice(i,1); budget--;
        spawnPiece(g,null,p.position.x,p.position.y,p.angle,0,0,0,p.gd,{density:p.gd.dens||.004,sh:p.gd.shape});
        break;
      }
    }
  }
}

// a flying tooth or blade that gets hit hard breaks into two smaller fragments
function splitPiece(g,b){
  const d=b.gd, sh=d.shape, ang=rand(0,Math.PI), nx=Math.cos(ang), ny=Math.sin(ang);
  const bv=getVel(b), ca=Math.cos(b.angle), sa=Math.sin(b.angle), vx=bv.x*VU, vy=bv.y*VU;
  const col=d.kind==='tooth'?'#4b4f69':(d.kind==='cogtooth'?d.c1:(d.kind==='plate'?'#c98a1c':(d.kind==='shard'?d.col:d.c2))), px=b.position.x, py=b.position.y, w=Body.getAngularVelocity(b)*VU;
  const group=-(100+((Math.random()*1e6)|0));
  let made=0;
  for(const s of [1,-1]){
    const half=clipHalf(sh.pts,nx*s,ny*s); if(half.length<3) continue;
    const wx=(ca*nx-sa*ny)*s, wy=(sa*nx+ca*ny)*s;
    if(spawnPiece(g,half,px,py,b.angle,vx+wx*90,vy+wy*90,w+rand(-8,8),
      {kind:'shard',col,owner:d.owner,shrap:true,group},{density:.004,ghost:.3})) made++;
  }
  if(!made) return;
  removeBody(g,b);
  for(let i=0;i<8;i++) addSpark(g,px,py,rand(-260,260),rand(-260,260),rand(.15,.35),'#fff3c4',rand(1,2.2));
  addRing(g,px,py,2,22,.2,'#ffffff',2);
}

// massive high-velocity shrapnel: 1-2 HP plus a tiny shove
function shrapnel(g,deb,f,rel){
  const d=deb.gd, bl=d.blast;
  if(!d.shrap||!f.alive||rel<SHRAPNEL_MIN||d.hitCd>0) return;
  if(d.shotBy===f.idx) return;                          // a polarity blast never hurts its own spinner
  if(!bl&&f.shrapCd>0) return;                          // a blast volley skips the shared cooldown but has its own HP cap
  if(d.owner===f.idx&&g.time-d.born<.8) return;
  let amt=1+clamp((rel-SHRAPNEL_MIN)/400,0,1);
  if(bl){ if(bl.left<=0) return; amt=Math.min(amt,bl.left); bl.left-=amt; }
  d.hitCd=.6; if(!bl) f.shrapCd=.15;
  const dx=f.x-deb.position.x, dy=f.y-deb.position.y, l=Math.hypot(dx,dy)||1;
  const kb=clamp(rel*.1,25,70)/Math.sqrt(f.m);
  f.vx+=dx/l*kb; f.vy+=dy/l*kb;
  addText(g,f.x,f.y-f.r-6,'-'+Math.round(amt),'#ffd9a0',16);
  addRing(g,deb.position.x,deb.position.y,2,20,.2,'#ffd9a0',2);
  f.addScar(Math.atan2(-dy,-dx),.16,1);   // small welt where the shrapnel struck
  damage(g,f,amt,true,null);
}
function processHits(g){
  const pw=g.pw, H=pw.hits; if(!H.length) return;
  let n=0;
  for(const h of H){
    if(++n>14) break;
    const deb=h.a.gd.type==='debris'?h.a:(h.b.gd.type==='debris'?h.b:null); if(!deb) continue;
    if(!pw.bodies.includes(deb)) continue;
    const other=deb===h.a?h.b:h.a, d=deb.gd;
    if(d.state==='captured') continue;   // ring pieces are driven by the orbit, not by hits
    if(h.rel>130&&n<=6) for(let k=0;k<3;k++) addSpark(g,h.x,h.y,rand(-210,210),rand(-210,210),rand(.15,.35),'#ffd9a0',rand(1,2));
    SFX.debris(h.rel);
    let splitAt=SPLIT_OTHER;
    if(other.gd.type==='fighter'){splitAt=SPLIT_FIGHTER; shrapnel(g,deb,other.gd.f,h.rel);}
    if(h.rel>splitAt&&(d.kind==='tooth'||d.kind==='blade'||d.kind==='cogtooth'||d.kind==='plate')&&d.state!=='captured'&&g.time-d.born>.25&&pw.bodies.includes(deb)) splitPiece(g,deb);
  }
  H.length=0;
}

// one half-substep of the Matter world; dt is already scaled by slow-mo
function physStep(g,dtIn){
  const pw=g.pw, eng=pw.engine, dt=dtIn*g.dil;   // dt: world time, slowed while Clockwork is in Overdrive
  pw.rs=g.dil*g.timeScale;
  // debris reacts to a fighter's effective speed, so a dilated fighter shoves it slowly
  for(const f of g.fighters) if(f.proxy){Body.setPosition(f.proxy,{x:f.x,y:f.y}); setVel(f.proxy,f.vx*f.ts,f.vy*f.ts);}
  for(const w of g.fighters){ // Whirl's gravity field drags nearby debris too
    if(!w.alive||w.id!=='whirl') continue;
    const A=w.auraR()*DEBRIS_REACH, pw2=w.fieldPow(), dt=dtIn*w.ts;
    for(const b of pw.bodies){
      if(b.gd.state==='captured') continue;   // a scrap ring is not Whirl's to steal
      const dx=w.x-b.position.x, dy=w.y-b.position.y, d=Math.hypot(dx,dy);
      if(d<A&&d>w.r*.8){
        const k=1-d/A, s=DEBRIS_PULL*pw2*k*(.35+.65*k)*dt/VU/d; // pull, strongest up close
        const sw=s*.35;                                         // a little sideways swirl so scraps orbit, not just fall in
        if(b.isSleeping) Sleeping.set(b,false);
        const v=getVel(b), damp=1-.05*k;                        // field also eases the floor drag
        Body.setVelocity(b,{x:v.x/damp+dx*s-dy*sw,y:v.y/damp+dy*s+dx*sw});
      }
    }
  }
  for(const k of g.fighters) if(k.sk&&k.alive) skPhys(g,k,dtIn);   // Scrap-King: ring orbit, magnet, blast
  eng.timing.timeScale=g.timeScale*g.dil;
  Engine.update(eng,1000/120);
  for(const b of pw.bodies){
    const v=getVel(b), s=Math.hypot(v.x,v.y), d=b.gd;
    if(s>MAXV) Body.setVelocity(b,{x:v.x*MAXV/s,y:v.y*MAXV/s});
    if(d.hitCd>0) d.hitCd-=dt;
    if(d.noCapT>0){d.noCapT-=dt; if(d.noCapT<=0&&d.state==='launched') d.state='free';}
    if(d.ghostT>0){d.ghostT-=dt; if(d.ghostT<=0){b.collisionFilter.mask=DEBRIS_MASK; b.collisionFilter.group=0; d.group=0;}}
  }
  processHits(g);
}

/* =====================================================================
   SCRAP-KING: magnetic salvage, orbiting ring, polarity blast
   All gd.state changes for captured / launched pieces happen in this block.
   ===================================================================== */
function skLoose(g){   // loose scrap on the floor: free live pieces plus settled records
  let n=g.pw.settled.length;
  for(const b of g.pw.bodies){const s=b.gd.state; if(!s||s==='free') n++;}
  return n;
}
function skCapture(g,k,b){
  const d=b.gd;
  d.state='captured'; d.ghostT=0; d.shrap=false; d.blast=null; d.shotBy=undefined; d.wear=0; d.group=0;
  b.sleepThreshold=Infinity; if(b.isSleeping) Sleeping.set(b,false);   // a sleeping body would ignore the orbit drive
  b.collisionFilter.group=0; b.collisionFilter.mask=CAT.WALL;          // ring pieces only touch the wall; contact with rivals is handled in ringContact()
  k.sk.ring.push(b); k.sk.pulse=Math.max(k.sk.pulse,.35);
  SFX.salvage();
  for(let i=0;i<4;i++) addSpark(g,b.position.x,b.position.y,rand(-160,160),rand(-160,160),rand(.12,.3),Math.random()<.5?'#ffb21a':'#fff3c4',rand(1,2));
}
// back to normal debris. shot=true marks it as part of a polarity blast (hurts the rival, never its shooter).
function skRelease(g,k,b,shot,vx,vy,blast){
  const d=b.gd;
  b.sleepThreshold=45;
  d.state=shot?'launched':'free'; d.noCapT=shot?.9:.7;
  b.collisionFilter.mask=DEBRIS_MASK&~FCAT[k.idx]; d.ghostT=.35;   // clears its former owner first; the ghost timer restores the normal mask
  if(shot){d.shotBy=k.idx; d.shrap=true; d.blast=blast; d.hitCd=0;}
  if(vx!=null) setVel(b,vx,vy);
}
function skReleaseAll(g,k){
  for(const b of k.sk.ring.slice()){
    const a=Math.atan2(b.position.y-k.y,b.position.x-k.x);
    skRelease(g,k,b,false,Math.cos(a)*150+k.vx*.5,Math.sin(a)*150+k.vy*.5);
  }
  k.sk.ring=[];
}
// rip 1-2 jagged rust shards off the arena rim so Scrap-King always has something to pull
function skRip(g,k){
  const th=Math.atan2(k.y,k.x), cnt=Math.random()<.5?1:2;
  for(let i=0;i<cnt;i++){
    const a=th+rand(-.45,.45), px=Math.cos(a)*(R-10), py=Math.sin(a)*(R-10), rad=rand(9,15), pts=[];
    for(let j=0;j<5;j++){const aa=j/5*TAU+rand(-.3,.3), rr=rad*rand(.55,1.1); pts.push([Math.cos(aa)*rr,Math.sin(aa)*rr]);}
    const dx=k.x-px, dy=k.y-py, l=Math.hypot(dx,dy)||1, sp=rand(200,320);
    spawnPiece(g,pts,px,py,rand(0,TAU),dx/l*sp,dy/l*sp,rand(-14,14),{kind:'shard',col:i?'#9a5226':'#7a3f1c',owner:-1,shrap:false},{density:.004,ghost:0});
    for(let s=0;s<8;s++) addSpark(g,px,py,-Math.cos(a)*rand(40,220)+rand(-120,120),-Math.sin(a)*rand(40,220)+rand(-120,120),rand(.15,.4),Math.random()<.5?'#ffb347':'#fff3c4',rand(1,2.2));
  }
  k.sk.fallN++; k.sk.fallT=4;
  addText(g,k.x,k.y-k.r-22,'SCRAP!','#ffb21a',16);
  SFX.salvage();
}
// polarity reversal: every orbiting piece is flung outward, leaning slightly toward the rival so it can miss but doesn't always
function polarityBlast(g,k){
  const sk=k.sk, ring=sk.ring.slice(), n=ring.length; if(!n) return;
  const rv=g.fighters.find(f=>f!==k&&f.alive), bl={left:SK_BLAST_CAP};
  let bx=0,by=0; if(rv){const dx=rv.x-k.x, dy=rv.y-k.y, l=Math.hypot(dx,dy)||1; bx=dx/l; by=dy/l;}
  for(const b of ring){
    let rx=b.position.x-k.x, ry=b.position.y-k.y; const rl=Math.hypot(rx,ry)||1; rx/=rl; ry/=rl;
    let dx=rx+bx*SK_BLAST_BIAS, dy=ry+by*SK_BLAST_BIAS; const dl=Math.hypot(dx,dy)||1; dx/=dl; dy/=dl;
    const j=rand(-.12,.12), cj=Math.cos(j), sj=Math.sin(j), sp=rand(SK_BLAST_V[0],SK_BLAST_V[1]);
    skRelease(g,k,b,true,(dx*cj-dy*sj)*sp+k.vx*.3,(dx*sj+dy*cj)*sp+k.vy*.3,bl);
    Body.setAngularVelocity(b,rand(-.5,.5));
    addSpark(g,b.position.x,b.position.y,rx*rand(120,380),ry*rand(120,380),rand(.15,.35),Math.random()<.5?'#ffb21a':'#fff3c4',rand(1.2,2.4));
  }
  sk.ring=[]; sk.pulse=1; sk.blastT=rand(4,6); sk.magT=1.1; sk.slam=false;   // magnet stays off briefly so it can't suck the volley straight back
  addRing(g,k.x,k.y,k.r*.8,k.r*3.6,.4,k.c2,5); addRing(g,k.x,k.y,k.r*.5,k.r*2.2,.3,'#ffffff',3);
  addText(g,k.x,k.y-k.r-24,'POLARITY!','#ffd166',20);
  g.shake=Math.max(g.shake,8); hitStop(g,HITSTOP.chip);
  SFX.polarity(n);
}
// per half-substep: keep the orbit alive, run the magnet, rip rim scrap if the floor is bare, and decide when to blast
function skPhys(g,k,dtIn){
  const sk=k.sk, pw=g.pw, q=k.ts/g.dil, dt=dtIn*k.ts;
  sk.ring=sk.ring.filter(b=>b.gd.state==='captured'&&pw.bodies.includes(b));   // drop pieces that were baked, split or removed
  const cap=k.skCap();
  while(sk.ring.length>cap) skRelease(g,k,sk.ring.pop(),false);                 // a lost plate shrinks the swarm
  sk.magT=Math.max(0,sk.magT-dt); sk.blastT-=dt; sk.pulse=Math.max(0,sk.pulse-dt*3);
  sk.ang+=dt*(2.6+.5*sk.ring.length);
  // orbit: drive velocity (never position) toward each slot, so the pieces keep colliding and can't tunnel
  const n=sk.ring.length, rr=k.r+SK_RING;
  for(let i=0;i<n;i++){
    const b=sk.ring[i], a=sk.ang+i*TAU/n;
    let tx=k.x+Math.cos(a)*rr, ty=k.y+Math.sin(a)*rr; const c=Math.hypot(tx,ty); if(c>R-10){tx*=(R-10)/c; ty*=(R-10)/c;}
    if(b.isSleeping) Sleeping.set(b,false);
    setVel(b,k.vx*q+(tx-b.position.x)*SK_GAIN,k.vy*q+(ty-b.position.y)*SK_GAIN);
    Body.setAngularVelocity(b,3/VU);
  }
  // magnet: loose pieces are pulled in and captured while there is room
  let pulling=false;
  if(sk.magT<=0&&n<cap){
    for(const b of pw.bodies){
      const d=b.gd; if((d.state&&d.state!=='free')||d.noCapT>0) continue;
      const dx=k.x-b.position.x, dy=k.y-b.position.y, dist=Math.hypot(dx,dy);
      if(dist>SK_MAG) continue;
      if(dist<rr+14&&sk.ring.length<cap){skCapture(g,k,b); continue;}
      pulling=true;
      const kf=1-dist/SK_MAG, s=SK_PULL*kf*(.3+.7*kf)*dt/VU/Math.max(dist,1);
      if(b.isSleeping) Sleeping.set(b,false);
      const v=getVel(b); Body.setVelocity(b,{x:v.x+dx*s,y:v.y+dy*s});
    }
  }
  sk.pulling=pulling;
  if(sk.ring.length||pulling) g.magnet=Math.max(g.magnet,(sk.ring.length?.3:0)+(pulling?.5:0));
  // floor salvage fallback: with fewer than 3 loose pieces anywhere, rip rim shards loose (limited per match)
  sk.fallT-=dt;
  if(sk.fallT<=0){
    sk.fallT=.5;
    if(sk.ring.length<cap&&sk.magT<=0&&sk.fallN<SK_FALL_MAX&&skLoose(g)<3) skRip(g,k);
  }
  // field arcs reaching for nearby scrap (visual only, at most about two alive at once)
  sk.arcT-=dt;
  if(sk.arcT<=0){
    sk.arcT=rand(.18,.45);
    const m=pw.bodies.length, st=m?(Math.random()*m)|0:0;
    for(let i=0;i<m;i++){
      const b=pw.bodies[(st+i)%m], s=b.gd.state; if(s&&s!=='free') continue;
      const dx=b.position.x-k.x, dy=b.position.y-k.y, dd=Math.hypot(dx,dy);
      if(dd>SK_MAG*.9||dd<k.r) continue;
      const pts=[[0,0]], seg=4, nx=-dy/dd, ny=dx/dd;
      for(let j=1;j<seg;j++){const u=j/seg, jit=rand(-1,1)*dd*.07; pts.push([dx*u+nx*jit,dy*u+ny*jit]);}
      pts.push([dx,dy]);
      g.parts.push({k:'arc',f:k,pts,life:.09,max:.09,col:Math.random()<.6?'#ffb21a':'#ffe08a'});
      break;
    }
  }
  // polarity blast: when armed and the ring faces the rival, on a timer, or right after a heavy wall slam
  if(sk.ring.length>=3||(sk.slam&&sk.ring.length>=2)){
    const rv=g.fighters.find(f=>f!==k&&f.alive);
    let go=false;
    if(sk.slam&&sk.blastT<3) go=true;
    else if(sk.blastT<=0&&rv){
      const bear=Math.atan2(rv.y-k.y,rv.x-k.x), dist=Math.hypot(rv.x-k.x,rv.y-k.y);
      let face=0; for(let i=0;i<sk.ring.length;i++) if(Math.abs(angDiff(sk.ang+i*TAU/sk.ring.length,bear))<.8) face++;
      go=(dist<k.r+rv.r+SK_RANGE&&face>=2)||sk.blastT<-3;   // never hold fire forever
    }
    if(go) polarityBlast(g,k);
  }
  sk.slam=false;
}
// a rival that plows into the ring is shoved back and shredded for 1-2 HP; ring pieces wear down and eventually break apart
function ringBreak(g,b){ if(g.pw.bodies.includes(b)) splitPiece(g,b); }
function ringContact(g){
  for(const k of g.fighters){
    if(!k.sk||!k.alive||!k.sk.ring.length) continue;
    for(const o of g.fighters){
      if(o===k||!o.alive||o.shredCd>0) continue;
      for(const b of k.sk.ring){
        const dx=o.x-b.position.x, dy=o.y-b.position.y, lim=o.r+SK_PR;
        if(dx*dx+dy*dy>lim*lim) continue;
        o.shredCd=SK_SHRED_CD;
        let ux=o.x-k.x, uy=o.y-k.y; const ul=Math.hypot(ux,uy)||1; ux/=ul; uy/=ul;
        o.vx+=ux*SK_SHOVE/Math.sqrt(o.m)/o.ts; o.vy+=uy*SK_SHOVE/Math.sqrt(o.m)/o.ts;
        k.vx-=ux*SK_SHOVE*.25/Math.sqrt(k.m)/k.ts; k.vy-=uy*SK_SHOVE*.25/Math.sqrt(k.m)/k.ts;
        const amt=1+Math.random();
        addText(g,o.x,o.y-o.r-6,'-'+Math.round(amt),'#ffb21a',15);
        damage(g,o,amt,true,Math.atan2(-uy,-ux));
        for(let i=0;i<12;i++){const a=Math.atan2(uy,ux)+rand(-1.2,1.2), s=rand(120,380); addSpark(g,b.position.x,b.position.y,Math.cos(a)*s,Math.sin(a)*s,rand(.15,.4),Math.random()<.5?'#ffb21a':'#fff3c4',rand(1,2.4));}
        SFX.debris(520);
        b.gd.wear=(b.gd.wear||0)+1; if(b.gd.wear>=SK_WEAR) ringBreak(g,b);
        break;
      }
    }
  }
}
// a hit that lands on Scrap-King wears a ring piece (the ring "absorbs" it; the damage cut itself is in takenMul)
function ringAbsorb(g,f){
  const r=f.sk.ring; if(!r.length) return;
  const b=r[(Math.random()*r.length)|0];
  b.gd.wear=(b.gd.wear||0)+2;
  for(let i=0;i<6;i++) addSpark(g,b.position.x,b.position.y,rand(-220,220),rand(-220,220),rand(.15,.35),'#ffb21a',rand(1,2.2));
  if(b.gd.wear>=SK_WEAR) ringBreak(g,b);
}
// dev check: a captured piece must be awake, in the world and in state 'captured'. Warns once per violation kind.
const skWarned={};
function skCheck(g){
  for(const k of g.fighters){
    if(!k.sk) continue;
    for(const b of k.sk.ring){
      const why=b.isSleeping?'asleep':(!g.pw.bodies.includes(b)?'missing from world':(b.gd.state!=='captured'?'wrong state':null));
      if(why&&!skWarned[why]){skWarned[why]=true; console.warn('[Scrap-King] ring invariant violated: captured piece is '+why);}
    }
  }
}

// dt is world time (dilated during Overdrive), rt is real time for particles flagged rt
function updateParts(wdt,g,rt){
  const P=g.parts;
  for(let i=P.length-1;i>=0;i--){
    const p=P[i], dt=p.rt?rt:wdt; p.life-=dt;
    if(p.life<=0){P.splice(i,1);continue;}
    if(p.k==='spark'){const d=Math.exp(-3*dt);p.vx*=d;p.vy*=d;p.x+=p.vx*dt;p.y+=p.vy*dt;}
    else if(p.k==='dot'){const d=Math.exp(-1.2*dt);p.vx*=d;p.vy*=d;p.x+=p.vx*dt;p.y+=p.vy*dt;}
    else if(p.k==='text'){p.x+=p.vx*dt;p.y+=p.vy*dt;}
    else if(p.k==='smoke'){const d=Math.exp(-1.5*dt);p.vx*=d;p.vy*=d;p.x+=p.vx*dt;p.y+=p.vy*dt;}
  }
  if(P.length>1800) P.splice(0,300);
}
function drawParts(c,g){
  c.save(); c.lineCap='round'; c.lineJoin='round';
  // dark smoke first, with normal blending, so sparks and arcs glow over it
  for(const p of g.parts){
    if(p.k!=='smoke') continue;
    const a=clamp(p.life/p.max,0,1), grow=1+(1-a)*1.8;
    c.globalAlpha=p.al*a; c.fillStyle=p.col||'#15151c';
    c.beginPath(); c.arc(p.x,p.y,p.size*grow,0,TAU); c.fill();
  }
  for(const p of g.parts){
    const a=clamp(p.life/p.max,0,1);
    if(p.k==='arc'){
      const f=p.f; c.globalCompositeOperation='lighter'; c.globalAlpha=a;
      c.beginPath(); p.pts.forEach((q,i)=>i?c.lineTo(f.x+q[0],f.y+q[1]):c.moveTo(f.x+q[0],f.y+q[1]));
      c.strokeStyle=p.col; c.lineWidth=Math.max(3,f.r*.1); c.globalAlpha=a*.55; c.stroke();   // glow
      c.strokeStyle='#ffffff'; c.lineWidth=Math.max(1.2,f.r*.035); c.globalAlpha=a; c.stroke();  // hot core
    } else if(p.k==='spark'){
      c.globalCompositeOperation='lighter'; c.globalAlpha=a; c.strokeStyle=p.col; c.lineWidth=p.size;
      c.beginPath(); c.moveTo(p.x,p.y); c.lineTo(p.x-p.vx*.045,p.y-p.vy*.045); c.stroke();
    } else if(p.k==='dot'){
      c.globalCompositeOperation='lighter'; c.globalAlpha=a*.9; c.fillStyle=p.col;
      c.beginPath(); c.arc(p.x,p.y,p.size*(.5+a*.5),0,TAU); c.fill();
    } else if(p.k==='ring'){
      const t=1-a, r=p.r0+(p.r1-p.r0)*(1-Math.pow(1-t,2));
      c.globalCompositeOperation='lighter'; c.globalAlpha=a; c.strokeStyle=p.col; c.lineWidth=p.lw*a+.5;
      c.beginPath(); c.arc(p.x,p.y,r,0,TAU); c.stroke();
    }
  }
  c.globalCompositeOperation='source-over';
  for(const p of g.parts){
    if(p.k!=='text') continue;
    const a=clamp(p.life/p.max*1.6,0,1);
    c.globalAlpha=a; c.font=`800 ${p.size}px ui-sans-serif,system-ui`; c.textAlign='center';
    c.lineWidth=3; c.strokeStyle='rgba(0,0,0,.7)'; c.strokeText(p.txt,p.x,p.y);
    c.fillStyle=p.col; c.fillText(p.txt,p.x,p.y);
  }
  c.restore();
}

/* =====================================================================
   SHATTER
   ===================================================================== */
function shatter(g,f){
  const N=18;
  for(let i=0;i<N;i++){
    const a0=i/N*TAU, a1=(i+1)/N*TAU, am=(a0+a1)/2+rand(-.05,.05);
    const inner=f.r*rand(0,.4);
    let pts=[
      [Math.cos(a0)*inner,Math.sin(a0)*inner],
      [Math.cos(a0)*f.r*rand(.85,1),Math.sin(a0)*f.r*rand(.85,1)],
      [Math.cos(am)*f.r*rand(.9,1.05),Math.sin(am)*f.r*rand(.9,1.05)],
      [Math.cos(a1)*f.r*rand(.85,1),Math.sin(a1)*f.r*rand(.85,1)],
      [Math.cos(a1)*inner,Math.sin(a1)*inner]
    ];
    let cx=0,cy=0; pts.forEach(p=>{cx+=p[0];cy+=p[1];}); cx/=pts.length; cy/=pts.length;
    const ang=Math.atan2(cy,cx), sp=rand(160,490);
    // real Matter bodies: they never collide with each other for the first moments (shared negative group), then pile up
    spawnPiece(g,pts,f.x,f.y,0,Math.cos(ang)*sp+f.vx*.6,Math.sin(ang)*sp+f.vy*.6,rand(-12,12),
      {kind:'shard',col:i%3===0?f.c2:(i%3===1?f.c1:shade(f.c1,-.45)),owner:f.idx,shrap:false,group:-77},
      {density:.003,ghost:.35});
  }
  for(let i=0;i<14;i++){ // small chips
    const s=rand(4,9), a=rand(0,TAU), sp=rand(250,680);
    spawnPiece(g,[[-s,-s*.6],[s,-s*.3],[0,s]],f.x,f.y,rand(0,TAU),Math.cos(a)*sp+f.vx*.4,Math.sin(a)*sp+f.vy*.4,rand(-20,20),
      {kind:'shard',col:Math.random()<.5?f.c2:'#cfd3e6',owner:f.idx,shrap:false,group:-77},
      {density:.003,ghost:.35});
  }
  for(let i=0;i<90;i++){
    const a=rand(0,TAU), s=rand(120,700);
    addSpark(g,f.x,f.y,Math.cos(a)*s,Math.sin(a)*s,rand(.3,.9),[f.c1,f.c2,'#fff3c4','#ffb347'][(Math.random()*4)|0],rand(1,3));
  }
  addRing(g,f.x,f.y,10,230,.55,f.c2,6);
  addRing(g,f.x,f.y,5,140,.4,'#ffffff',4);
}

/* =====================================================================
   DAMAGE / KO
   ===================================================================== */
// Clockwork in Overdrive is hard to hurt (but never immune). Touch hits are reduced in resolveCollision so the numbers shown match.
// Scrap-King's orbiting ring soaks up to SK_SHIELD of any hit once it holds 6+ pieces (scaled below that)
function takenMul(f){
  if(f.clk&&f.clk.phase==='over') return CW_OVER_TAKEN;
  if(f.sk) return 1-SK_SHIELD*clamp(f.sk.ring.length/6,0,1);
  return 1;
}
function damage(g,f,amt,isDot,cang){
  if(!f.alive) return;
  if(isDot) amt*=takenMul(f);   // burns and shrapnel
  if(!isDot&&f.sk) ringAbsorb(g,f);
  f.hp=Math.max(0,f.hp-amt);
  f.flash=Math.max(f.flash,isDot?.18:1);
  // heavy touch hits leave a glowing welt at the exact impact angle (same 7% threshold as the chip logic)
  if(!isDot&&cang!=null){const big=amt/f.maxHp; if(big>.07) f.addScar(cang,clamp(.2+big*.9,.2,.42),1);}
  chipParts(g,f,amt,isDot,cang);
  if(f.hp<=0) kill(g,f);
  else if(!f.lastStand&&f.hp/f.maxHp<LAST_STAND) lastStand(g,f);
}
// one-off dramatic burst the first time a fighter drops under 20% HP; audio.js picks up the heartbeat from game state
function lastStand(g,f){
  f.lastStand=true;
  for(let i=0;i<40;i++){
    const a=rand(0,TAU), s=rand(180,520);
    addSpark(g,f.x+Math.cos(a)*f.r*.8,f.y+Math.sin(a)*f.r*.8,Math.cos(a)*s,Math.sin(a)*s,rand(.25,.6),['#ff3b3b','#5ab0ff','#fff3c4'][(Math.random()*3)|0],rand(1.2,2.8));
  }
  addRing(g,f.x,f.y,f.r*.6,f.r*3,.5,'#ff3b3b',4);
  addText(g,f.x,f.y-f.r-24,'LAST STAND','#ff6b6b',20);
  g.shake=Math.max(g.shake,9);
}
function chipParts(g,f,amt,isDot,cang){
  const N=f.parts.length; if(!N||f.hp<=0) return;
  const target=Math.floor((1-f.hp/f.maxHp)*N*.9);
  let want=Math.max(0,target-f.lostCount());
  if(!isDot){const big=amt/f.maxHp; if(big>.07) want+=1; if(big>.16) want+=1;}
  while(want-->0) if(!f.detachPart(g,isDot?null:cang,true)) break;
}
function kill(g,f){
  f.alive=false;
  dropProxy(g,f);              // so the explosion isn't boxed in by the dead fighter's own circle
  if(f.sk) skReleaseAll(g,f);  // no piece may stay "captured" by a dead Scrap-King
  f.detachAll(g);
  shatter(g,f);
  SFX.shatter(f.r);
  g.shake=Math.max(g.shake,24); g.slowT=1.3; hitStop(g,HITSTOP.ko);
  const alive=g.fighters.filter(x=>x.alive);
  if(alive.length===0){g.over=true; g.winner=null;}
  else if(!g.over){g.over=true; g.winner=alive[0]; g.endT=0;}
  else if(g.over && g.winner && !g.winner.alive){g.winner=null;}
}

/* =====================================================================
   PHYSICS STEP
   ===================================================================== */
const DIL_VCAP=520;   // raw speed cap for a dilated fighter, so a hit taken in slow-motion can't launch it when time resumes
function resolveCollision(g){
  const[a,b]=g.fighters; if(!a.alive||!b.alive) return;
  let dx=b.x-a.x, dy=b.y-a.y; const d=Math.hypot(dx,dy), min=a.r+b.r;
  if(d>=min||d===0) return;
  const nx=dx/d, ny=dy/d, ov=min-d, im1=1/a.m, im2=1/b.m, sum=im1+im2;
  a.x-=nx*ov*im1/sum; a.y-=ny*ov*im1/sum; b.x+=nx*ov*im2/sum; b.y+=ny*ov*im2/sum;
  // impulses are solved in effective (real-time) velocities, then converted back to each fighter's own time frame
  const ta=a.ts, tb=b.ts;
  const vn=(a.vx*ta-b.vx*tb)*nx+(a.vy*ta-b.vy*tb)*ny;
  const closing=vn>0;
  if(!closing && (a.sepCd>0||b.sepCd>0)) return;   // overlapping but already parting: don't re-kick every tick
  // normal impulse, then top it up so the pair always separates at SEP_MIN (SEP_SOFT if they were only grinding)
  let j=closing?E_FIGHT*vn/sum:0;
  const vsep=j*sum-vn, need=closing?SEP_MIN:SEP_SOFT;
  if(vsep<need) j+=(need-vsep)/sum;
  // spin-kick: the rims slip past each other, so each spinner is deflected sideways, scaled by its spin rate
  const tx=-ny, ty=nx;
  const vs=a.spin*a.r+b.spin*b.r;
  const jt=clamp(vs*SPIN_KICK*rand(.9,1.1)*(closing?clamp(vn/250,.35,1):.3),-JT_MAX,JT_MAX)/sum;
  a.vx+=(-j*nx-jt*tx)*im1/ta; a.vy+=(-j*ny-jt*ty)*im1/ta;
  b.vx+=( j*nx+jt*tx)*im2/tb; b.vy+=( j*ny+jt*ty)*im2/tb;
  for(const f of [a,b]){
    f.steerT=STEER_T;   // AI loses steering briefly so the ricochet carries
    if(!closing) f.sepCd=.12;
    if(f.id==='whirl'&&closing&&vn>45) f.orbit*=-1;
  }
  for(const f of [a,b]) if(f.ts<1){const s=Math.hypot(f.vx,f.vy); if(s>DIL_VCAP){f.vx*=DIL_VCAP/s; f.vy*=DIL_VCAP/s;}}
  if(!closing||vn<45) return;
  const vout=-((a.vx*ta-b.vx*tb)*nx+(a.vy*ta-b.vy*tb)*ny);   // real separating speed after the bounce
  const cx=a.x+nx*a.r, cy=a.y+ny*a.r;
  const dA=a.hitCd<=0?a.contactDamage(vn)*takenMul(b):0;   // damage a deals to b
  const dB=b.hitCd<=0?b.contactDamage(vn)*takenMul(a):0;   // damage b deals to a
  let big=0;
  if(dA>0){a.hitCd=a.hitCdTime(); addText(g,b.x,b.y-b.r-6,'-'+Math.round(dA),'#ffd166',clamp(14+dA*.6,15,34)); damage(g,b,dA,false,Math.atan2(-ny,-nx)); big=Math.max(big,dA); a.rage=0; if(dA>14) b.stallT=STALL_TIME;}
  if(dB>0){b.hitCd=b.hitCdTime(); addText(g,a.x,a.y-a.r-6,'-'+Math.round(dB),'#ffd166',clamp(14+dB*.6,15,34)); damage(g,a,dB,false,Math.atan2(ny,nx)); big=Math.max(big,dB); b.rage=0; if(dB>14) a.stallT=STALL_TIME;}
  impactSparks(g,cx,cy,nx,ny,vn,[a.c1,b.c1,a.c2,b.c2],big>0);
  SFX.clang(vn,a.m,b.m,big);
  if(vout>RIC_MIN&&vn>260) SFX.ricochet(vout,Math.abs(jt*sum));   // extra-hard ricochet gets its own whang on top
  g.shake=Math.max(g.shake,clamp(vn*.016,1,5.5),clamp(big*.3,0,12));
  if(big>14) hitStop(g,HITSTOP.massive);
  else if(big>7||vn>220) hitStop(g,HITSTOP.medium);
}
function stepSim(dtIn,g){
  const dt=dtIn;
  for(const f of g.fighters) if(f.alive) f.step(dt*f.ts,g);
  resolveCollision(g);
  ringContact(g);
  physStep(g,dt);
  // Whirl gravity fields: the closer the rival, the harder it burns
  for(const w of g.fighters){
    if(!w.alive||w.id!=='whirl') continue;
    const dt=dtIn*w.ts;   // her field runs on her own (possibly dilated) clock
    const A=w.auraR(); let hit=false;
    for(const v of g.fighters){
      if(v===w||!v.alive) continue;
      const dx=w.x-v.x, dy=w.y-v.y, d=Math.hypot(dx,dy);
      if(d<A&&d>1){
        hit=true;
        const touch=w.r+v.r, k=clamp(1-(d-touch)/(A-touch),0,1), nx=dx/d, ny=dy/d;
        g.sizzle=Math.max(g.sizzle,k);
        const pull=PULL*(.3+.7*k)*(.6+.4*w.aliveFrac());
        v.vx+=nx*pull/v.m*dt; v.vy+=ny*pull/v.m*dt;
        const dmg=DOT_DPS*w.fieldPow()*(.06+.94*k*k)*dt;
        v.dotAcc+=dmg; v.dotT-=dt; v.dotSpark-=dt;
        if(v.dotSpark<=0){
          v.dotSpark=.1-.07*k;
          g.parts.push({k:'dot',x:v.x+rand(-v.r,v.r)*.8,y:v.y+rand(-v.r,v.r)*.8,vx:nx*90+rand(-30,30),vy:ny*90+rand(-30,30),life:.35,max:.35,col:w.c2,size:rand(2,3.5)});
        }
        if(v.dotT<=0&&v.dotAcc>=.5){
          addText(g,v.x+rand(-8,8),v.y-v.r-4,'-'+Math.max(1,Math.round(v.dotAcc)),w.c2,clamp(12+v.dotAcc*1.2,12,26));
          v.dotAcc=0; v.dotT=.5;
        }
        damage(g,v,dmg,true,null);
      }
    }
    w.pull+=((hit?1:0)-w.pull)*Math.min(1,dt*6);
    w.emitT-=dt;
    if(w.emitT<=0){
      w.emitT=.02;
      const a=rand(0,TAU), rr=A*rand(.7,1);
      g.parts.push({k:'dot',x:w.x+Math.cos(a)*rr,y:w.y+Math.sin(a)*rr,vx:-Math.cos(a)*170-Math.sin(a)*60,vy:-Math.sin(a)*170+Math.cos(a)*60,life:.7,max:.7,col:w.c2,size:rand(1,2.2)});
    }
  }
}

/* =====================================================================
   RENDERING THE ARENA
   ===================================================================== */
function drawArenaFloor(c,t){
  const g=c.createRadialGradient(0,0,0,0,0,R);
  g.addColorStop(0,'#232647'); g.addColorStop(.65,'#161830'); g.addColorStop(1,'#0c0d1a');
  c.fillStyle=g; c.beginPath(); c.arc(0,0,R,0,TAU); c.fill();
  c.strokeStyle='rgba(255,255,255,.05)'; c.lineWidth=2;
  for(let i=1;i<=4;i++){c.beginPath(); c.arc(0,0,R*i/5,0,TAU); c.stroke();}
  for(let i=0;i<16;i++){const a=i/16*TAU; c.beginPath(); c.moveTo(Math.cos(a)*R*.12,Math.sin(a)*R*.12); c.lineTo(Math.cos(a)*R,Math.sin(a)*R); c.stroke();}
  // rim
  c.save();
  c.shadowColor='#6d7bff'; c.shadowBlur=30; c.lineWidth=18; c.strokeStyle='#2b2e50';
  c.beginPath(); c.arc(0,0,R+9,0,TAU); c.stroke(); c.restore();
  c.lineWidth=2.5; c.strokeStyle='rgba(139,149,255,.75)'; c.beginPath(); c.arc(0,0,R,0,TAU); c.stroke();
  c.save(); c.lineWidth=5; c.strokeStyle='rgba(255,207,90,.22)'; c.setLineDash([22,16]); c.lineDashOffset=-t*10;
  c.beginPath(); c.arc(0,0,R+9,0,TAU); c.stroke(); c.restore();
}
function drawAura(c,w,t){
  const A=w.auraR(), a=.5+.5*w.pull;
  const g=c.createRadialGradient(w.x,w.y,w.r,w.x,w.y,A);
  g.addColorStop(0,rgba(w.c2,.05+.1*w.pull)); g.addColorStop(.85,rgba(w.c1,.12+.1*w.pull)); g.addColorStop(1,rgba(w.c1,0));
  c.fillStyle=g; c.beginPath(); c.arc(w.x,w.y,A,0,TAU); c.fill();
  c.save(); c.translate(w.x,w.y); c.rotate(t*1.4);
  c.strokeStyle=rgba(w.c2,.35*a+.1); c.lineWidth=2; c.setLineDash([10,14]);
  c.beginPath(); c.arc(0,0,A*.98,0,TAU); c.stroke();
  c.rotate(-t*2.6); c.setLineDash([4,18]); c.strokeStyle=rgba(w.c1,.5*a); c.beginPath(); c.arc(0,0,A*.7,0,TAU); c.stroke();
  c.restore();
}
function drawBeams(c,g,t){
  for(const w of g.fighters){
    if(!w.alive||w.id!=='whirl') continue;
    const A=w.auraR();
    for(const v of g.fighters){
      if(v===w||!v.alive) continue;
      const d=Math.hypot(w.x-v.x,w.y-v.y); if(d>=A) continue;
      const touch=w.r+v.r, k=clamp(1-(d-touch)/(A-touch),0,1);
      c.save(); c.globalCompositeOperation='lighter';
      c.strokeStyle=rgba(w.c2,.25+.6*k); c.lineWidth=1.5+4.5*k; c.setLineDash([4,8]); c.lineDashOffset=t*60;
      c.beginPath(); c.moveTo(w.x,w.y); c.lineTo(v.x,v.y); c.stroke(); c.restore();
    }
  }
}

function renderGame(){
  const g=game; const t=g.time;
  ctx.setTransform(DPR,0,0,DPR,0,0);
  ctx.fillStyle='#07070d'; ctx.fillRect(0,0,W,H);
  const bg=ctx.createRadialGradient(W/2,H/2,0,W/2,H/2,Math.max(W,H)*.7);
  bg.addColorStop(0,'#14152a'); bg.addColorStop(1,'#050509');
  ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);
  const top=110, availH=H-top-10;
  const s=Math.min(W/(2*R+70),availH/(2*R+70));
  const sk=g.shake+(g.hitStop>0?3:0);   // a small tremor while the world is frozen on impact
  const cx=W/2+rand(-1,1)*sk, cy=top+availH/2+rand(-1,1)*sk;
  ctx.save(); ctx.translate(cx,cy); ctx.scale(s,s);
  drawArenaFloor(ctx,t);
  ctx.drawImage(g.pw.floor,-FLOOR_HALF,-FLOOR_HALF,FLOOR_HALF*2,FLOOR_HALF*2);   // oldest overflow of the pile, baked
  for(const b of g.pw.settled) drawPiece(ctx,b);                                   // resting pieces that can still wake up
  for(const b of g.pw.bodies) drawPiece(ctx,b);
  for(const f of g.fighters) if(f.alive&&f.sk) drawField(ctx,f,t);
  for(const f of g.fighters) if(f.alive&&f.id==='whirl') drawAura(ctx,f,t);
  drawBeams(ctx,g,t);
  const fo=f=>({id:f.id,x:f.x,y:f.y,r:f.r,angle:f.angle,c1:f.c1,c2:f.c2,hp:f.hp/f.maxHp,rage:f.rage,flash:f.flash,t:f.t,parts:f.parts,scars:f.scars,clk:f.clk,sk:f.sk?{n:f.sk.ring.length,cap:f.skCap(),pulse:f.sk.pulse}:null});
  const boosted=f=>f.clk&&f.clk.phase==='over';
  for(const f of g.fighters) if(f.alive&&!(g.dilK>.01&&boosted(f))) drawTop(ctx,fo(f));
  if(g.dilK>.01){
    // Sandevistan screen treatment: the arena cools and darkens, then the boosted fighter and its afterimages are drawn over it
    const k=g.dilK, og=ctx.createRadialGradient(0,0,R*.3,0,0,R*1.05);
    og.addColorStop(0,`rgba(10,34,56,${.2*k})`); og.addColorStop(1,`rgba(0,8,22,${.55*k})`);
    ctx.fillStyle=og; ctx.beginPath(); ctx.arc(0,0,R+22,0,TAU); ctx.fill();
    for(const f of g.fighters) if(f.alive&&boosted(f)){drawGhosts(ctx,f); drawTop(ctx,fo(f));}
  } else {
    for(const f of g.fighters) if(f.alive) drawGhosts(ctx,f);   // afterimages of an Overdrive that just ended fade out on their own
  }
  drawParts(ctx,g);
  ctx.restore();
  // countdown
  ctx.textAlign='center'; ctx.textBaseline='middle';
  if(g.countdown>0){
    const n=Math.ceil(g.countdown), frac=g.countdown%1;
    ctx.font='900 120px ui-sans-serif,system-ui'; ctx.fillStyle=`rgba(255,255,255,${.35+.65*frac})`;
    ctx.save(); ctx.translate(W/2,H/2); ctx.scale(.8+frac*.4,.8+frac*.4); ctx.fillText(n>3?3:n,0,0); ctx.restore();
  } else if(g.fightT>0){
    ctx.font='900 110px ui-sans-serif,system-ui'; ctx.fillStyle=`rgba(255,160,60,${clamp(g.fightT/.9,0,1)})`;
    ctx.fillText('FIGHT!',W/2,H/2);
  }
  ctx.textBaseline='alphabetic';
}

/* =====================================================================
   HUD
   ===================================================================== */
function hudHTML(i,f){
  const right=i===1;
  const side=right?'right-0':'left-0';
  const hint=f.ctrl==='cpu'?'CPU':(i===0?'WASD':'ARROWS');
  return `
    <div class="flex items-baseline justify-between ${right?'flex-row-reverse':''}">
      <span class="font-extrabold tracking-wide text-lg" style="color:${f.c1}">${f.name}</span>
      <span class="text-[11px] text-slate-400 tracking-widest">${hint}</span>
    </div>
    <div class="relative h-4 rounded bg-black/50 border border-white/10 overflow-hidden mt-1">
      <div id="lag${i}" class="absolute inset-y-0 ${side} bg-white/60"></div>
      <div id="hp${i}" class="absolute inset-y-0 ${side}" style="background:linear-gradient(${right?270:90}deg,${f.c1},${f.c2})"></div>
    </div>
    <div class="flex justify-between text-[11px] mt-1 text-slate-300 ${right?'flex-row-reverse':''}">
      <span id="hpt${i}"></span><span id="ml${i}" class="tracking-widest"></span>
    </div>
    <div class="h-1.5 rounded bg-black/50 mt-0.5 overflow-hidden relative">
      <div id="mt${i}" class="absolute inset-y-0 ${side}" style="background:${f.id==='bigboy'?'linear-gradient(90deg,#f59e0b,#ef4444)':'linear-gradient(90deg,'+f.c1+','+f.c2+')'}"></div>
    </div>
    <div id="pp${i}" class="flex gap-1 mt-1.5 ${right?'justify-end':''}"></div>`;
}
function updateHud(g){
  g.fighters.forEach((f,i)=>{
    const hp=$('#hp'+i); if(!hp) return;
    $('#hud'+i).classList.toggle('last-stand',f.alive&&f.lastStand);
    $('#hp'+i).style.width=(f.hp/f.maxHp*100)+'%';
    $('#lag'+i).style.width=(f.hpLag/f.maxHp*100)+'%';
    $('#hpt'+i).textContent=Math.ceil(f.hp)+' / '+f.maxHp;
    if(f._pk!==f.lostCount()){f._pk=f.lostCount(); $('#pp'+i).innerHTML=f.parts.map(p=>`<span class="inline-block w-2.5 h-2.5 rounded-sm" style="background:${p.alive?f.c2:'rgba(255,255,255,.12)'}"></span>`).join('');}
    if(f.id==='bigboy'){
      $('#ml'+i).textContent='RAGE  x'+(1+f.rage*3).toFixed(1)+' DMG';
      $('#mt'+i).style.width=(f.rage*100)+'%';
    } else if(f.id==='clockwork'){
      const c=f.clk, cfg=f.cwCfg(), ph=c.phase, bar=$('#mt'+i);
      if(f._ph!==ph){   // recolour the meter only when the phase changes
        f._ph=ph;
        bar.style.background=ph==='over'?'linear-gradient(90deg,#22d3ee,#fde68a)':(ph==='burn'?'linear-gradient(90deg,#7f1d1d,#ef4444)':'linear-gradient(90deg,'+f.c2+','+f.c1+')');
      }
      let txt, w;
      if(ph==='over'){txt='OVERDRIVE '+Math.max(0,CW_OVER-c.t).toFixed(1)+'s'; w=Math.max(0,1-c.t/CW_OVER)*100;}
      else if(ph==='burn'){txt='BURNOUT'; w=Math.max(0,1-c.t/cfg.burn)*100;}
      else{txt='C'+Math.min(c.cycle,9)+' WIND-UP '+c.tick+'/'+cfg.ticks; w=(c.tick+c.t/cfg.iv)/cfg.ticks*100;}
      $('#ml'+i).textContent=txt; bar.style.width=Math.min(100,w)+'%';
    } else if(f.id==='scrapking'){
      const n=f.sk.ring.length, cap=f.skCap();
      $('#ml'+i).textContent='SCRAP '+n+'/'+cap+(n>=3?'  BLAST '+Math.max(0,f.sk.blastT).toFixed(1)+'s':(f.sk.pulling?'  PULLING':''));
      $('#mt'+i).style.width=(cap?n/cap*100:0)+'%';
    } else {
      $('#ml'+i).textContent=f.pull>.05?'GRAVITY LOCKED ON':'GRAVITY FIELD';
      $('#mt'+i).style.width=(30+f.pull*70)+'%';
    }
  });
}

/* =====================================================================
   GAME LIFECYCLE
   ===================================================================== */
function show(id){
  ['menu','select','game','pause','end'].forEach(s=>$('#'+s).classList.toggle('hidden',s!==id&&!(id==='game'&&false)));
}
function setScreen(name){
  state=name;
  $('#menu').classList.toggle('hidden',name!=='menu');
  $('#select').classList.toggle('hidden',name!=='select');
  $('#game').classList.toggle('hidden',name!=='game');
  $('#pause').classList.add('hidden');
  $('#end').classList.add('hidden');
  if(name==='select'){activeSlot=0; renderCards();}
}
function startGame(){
  applyDefaults();
  const f0=new Fighter(DEFS[sel[0].fighter],sel[0],0,-R*.55,0);
  const f1=new Fighter(DEFS[sel[1].fighter],sel[1],1,R*.55,0);
  game={fighters:[f0,f1],parts:[],shake:0,hitStop:0,slowT:0,timeScale:1,dil:1,dilK:0,acc:0,scrape:0,sizzle:0,magnet:0,
        countdown:3.0,fightT:0,over:false,winner:null,endT:0,endShown:false,paused:false,time:0};
  game.pw=createWorld(game);
  makeProxy(game,f0); makeProxy(game,f1);
  $('#hud0').innerHTML=hudHTML(0,f0); $('#hud1').innerHTML=hudHTML(1,f1);
  setScreen('game');
}
function showEnd(){
  const g=game; g.endShown=true;
  const el=$('#endTitle');
  if(g.winner){el.textContent=g.winner.name+' WINS'; el.style.color=g.winner.c1; el.style.textShadow=`0 0 40px ${g.winner.c1}`;}
  else {el.textContent='DOUBLE K.O.'; el.style.color='#e2e8f0'; el.style.textShadow='none';}
  $('#end').classList.remove('hidden');
}
function setPause(p){
  if(state!=='game'||!game||game.over&&game.endShown) return;
  game.paused=p; $('#pause').classList.toggle('hidden',!p);
}

// Sandevistan: while exactly one Clockwork is in Overdrive, every other fighter, Matter debris and world particle
// runs at CW_SLOW. Two Clockworks in Overdrive cancel out. A KO or a decided match ends it at once.
function updateDilation(g){
  const od=g.over?[]:g.fighters.filter(f=>f.alive&&f.clk&&f.clk.phase==='over');
  const solo=od.length===1;
  g.dil=solo?CW_SLOW:1;
  for(const f of g.fighters) f.ts=solo&&f!==od[0]?CW_SLOW:1;
}
// one fixed 60 Hz simulation tick. A hit-stop tick does nothing at all (sim, Matter and particles freeze).
function simTick(g){
  if(g.hitStop>0){g.hitStop--; return false;}
  if(g.slowT>0) g.slowT=Math.max(0,g.slowT-SIM_DT);
  g.timeScale=g.slowT>0?.25+.75*(1-g.slowT/1.3):1;
  const dt=SIM_DT*g.timeScale;
  updateDilation(g);
  if(g.countdown>0){
    g.countdown-=SIM_DT; if(g.countdown<=0){g.fightT=.9;}
    for(const f of g.fighters){f.t+=dt; f.angle+=f.spin*dt;}
  } else {
    g.fightT=Math.max(0,g.fightT-SIM_DT);
    for(const f of g.fighters) if(f.clk&&f.alive) f.clockStep(dt,g);   // real time: never dilated
    updateDilation(g);   // a clock step may have just started or ended Overdrive
    stepSim(dt/2,g); stepSim(dt/2,g);
  }
  updateParts(dt*g.dil,g,dt);
  wakeSettled(g);
  if(++g.pw.tick%15===0){maintainPile(g); skCheck(g);}
  if(g.over){g.endT+=SIM_DT; if(!g.endShown&&g.endT>2.4) showEnd();}
  return true;
}
function updateGame(rdt){
  const g=game; if(g.paused){SFX.silence(); return;}
  g.time+=rdt;
  g.shake*=Math.exp(-9*rdt);
  g.acc=Math.min(g.acc+rdt,SIM_DT*5);
  let ran=false;
  while(g.acc>=SIM_DT){
    g.acc-=SIM_DT;
    if(!ran){g.scrape=0; g.sizzle=0; g.magnet=0;}   // loop-sound levels are gathered fresh on every frame that simulates
    ran=true;
    simTick(g);
  }
  if(ran){SFX.scrape(g.scrape); SFX.sizzle(g.sizzle); SFX.magnet(g.magnet);}
  // heartbeat urgency 0..1: rises as a fighter in Last Stand drops from 20% HP toward 0. Silent once the match is decided.
  let hb=0;
  if(!g.over) for(const f of g.fighters) if(f.alive&&f.lastStand) hb=Math.max(hb,clamp(1-f.hp/(f.maxHp*LAST_STAND),0,1)*.85+.15);
  SFX.heartbeat(hb);
  SFX.timeWarp(g.dil<1);                                       // muffle the mix while time is dilated
  g.dilK+=((g.dil<1?1:0)-g.dilK)*Math.min(1,rdt*8);            // eased 0..1 for the screen treatment
  for(const f of g.fighters) f.hpLag+=(f.hp-f.hpLag)*Math.min(1,rdt*2.5);
  updateHud(g);
}

/* =====================================================================
   BACKDROP FOR MENU / SELECT
   ===================================================================== */
let bgT=0;
function renderBg(dt){
  bgT+=dt;
  ctx.setTransform(DPR,0,0,DPR,0,0);
  const bg=ctx.createRadialGradient(W/2,H/2,0,W/2,H/2,Math.max(W,H)*.75);
  bg.addColorStop(0,'#1a1b36'); bg.addColorStop(1,'#050509');
  ctx.fillStyle=bg; ctx.fillRect(0,0,W,H);
  const s=Math.min(W,H)/(2*R+60)*1.25;
  ctx.save(); ctx.translate(W/2,H/2); ctx.scale(s,s); ctx.globalAlpha=.55; drawArenaFloor(ctx,bgT);
  ctx.globalAlpha=.8;
  const a=bgT*.55, b=bgT*.8;
  drawTop(ctx,{id:'bigboy',x:Math.cos(a)*R*.5,y:Math.sin(a*1.3)*R*.45,r:44,angle:bgT*9,c1:'#e8442b',c2:'#ffc93c',hp:1,rage:.4,t:bgT});
  drawTop(ctx,{id:'whirl',x:Math.cos(b+2)*R*.55,y:Math.sin(b*1.2+1)*R*.5,r:29,angle:bgT*22,c1:'#7c4dff',c2:'#2ef2d0',hp:1,t:bgT});
  const k=bgT*.4;
  drawTop(ctx,{id:'clockwork',x:Math.cos(k+4)*R*.5,y:Math.sin(k*1.4+2)*R*.45,r:36,angle:bgT*12,c1:'#d9a441',c2:'#c0642f',hp:1,t:bgT,clk:previewClk(bgT)});
  const m=bgT*.33;
  drawTop(ctx,{id:'scrapking',x:Math.cos(m+1)*R*.5,y:Math.sin(m*1.2+4)*R*.45,r:40,angle:bgT*9,c1:'#b4592a',c2:'#ffb21a',hp:1,t:bgT});
  ctx.restore();
  ctx.fillStyle='rgba(5,5,10,.45)'; ctx.fillRect(0,0,W,H);
}

/* =====================================================================
   SELECT SCREEN UI
   ===================================================================== */
function applyDefaults(){
  for(let i=0;i<2;i++){
    const mirror=i===1&&sel[0].fighter===sel[1].fighter;
    const p=SIG[sel[i].fighter][mirror?'rival':'main'];
    sel[i].mirror=mirror; sel[i].c1=p[0]; sel[i].c2=p[1];
  }
}
function statBars(d,i){
  const col=i===0?'bg-orange-400':'bg-sky-400';
  return Object.entries(d.stats).map(([k,v])=>`
    <div><div class="flex justify-between text-[11px] text-slate-400"><span>${k}</span></div>
    <div class="h-1.5 rounded bg-white/10"><div class="h-full rounded ${col}" style="width:${v}%"></div></div></div>`).join('');
}
let activeSlot=0;   // which player the next roster pick goes to
function cardHTML(i){
  const s=sel[i], d=DEFS[s.fighter];
  const accent=i?'text-sky-300':'text-orange-300';
  const ring=activeSlot===i?(i?'border-sky-400/80 shadow-[0_0_24px_rgba(56,189,248,.25)]':'border-orange-400/80 shadow-[0_0_24px_rgba(251,146,60,.25)]'):'border-white/10';
  return `
  <div data-act="slot" data-i="${i}" class="rounded-2xl border ${ring} bg-white/5 backdrop-blur p-4 cursor-pointer transition">
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs tracking-[0.3em] font-bold ${accent}">PLAYER ${i+1} &middot; ${d.name.toUpperCase()}${activeSlot===i?' &middot; PICKING':''}</span>
      <div class="flex rounded-lg overflow-hidden border border-white/10 text-xs font-bold">
        <button data-act="ctrl" data-i="${i}" data-v="human" class="px-3 py-1.5 ${s.ctrl==='human'?'bg-white text-black':'text-slate-300 hover:bg-white/10'}">HUMAN</button>
        <button data-act="ctrl" data-i="${i}" data-v="cpu" class="px-3 py-1.5 ${s.ctrl==='cpu'?'bg-white text-black':'text-slate-300 hover:bg-white/10'}">CPU</button>
      </div>
    </div>
    <div class="flex gap-4 items-center">
      <canvas data-prev="${i}" width="200" height="200" class="w-36 h-36 shrink-0 rounded-xl bg-black/30"></canvas>
      <div class="flex-1 space-y-2">${statBars(d,i)}<div class="text-[11px] text-slate-400">HP ${d.hp}</div></div>
    </div>
    <p class="text-sm text-slate-300/80 mt-3 min-h-[7.5rem]">${d.desc}</p>
    <div class="mt-3 flex items-center gap-2 text-xs text-slate-400">
      <span class="w-5 h-5 rounded-full border border-white/30" style="background:${s.c1}"></span>
      <span class="w-5 h-5 rounded-full border border-white/30" style="background:${s.c2}"></span>
      <span>${s.mirror?'Rival colours (mirror match)':'Signature colours'}</span>
    </div>
  </div>`;
}
// roster: one tile per spinner in DEFS. Adding a spinner to DEFS adds a tile, no menu changes needed.
function rosterHTML(){
  return Object.values(DEFS).map(d=>{
    const picks=[0,1].filter(i=>sel[i].fighter===d.id);
    const badges=picks.map(i=>`<span class="px-1.5 py-0.5 rounded text-[10px] font-black ${i?'bg-sky-400 text-black':'bg-orange-400 text-black'}">P${i+1}</span>`).join('');
    const ring=picks.length?(picks.includes(activeSlot)?'border-white/70 bg-white/15':'border-white/40 bg-white/10'):'border-white/10 bg-white/5 hover:bg-white/10';
    return `
    <button data-act="pick" data-v="${d.id}" data-sfx="select" class="relative flex flex-col items-center rounded-2xl border ${ring} p-3 transition hover:scale-[1.03]">
      <span class="absolute top-2 right-2 flex gap-1">${badges}</span>
      <canvas data-roster="${d.id}" width="120" height="120" class="w-24 h-24 rounded-xl bg-black/30"></canvas>
      <div class="mt-2 font-extrabold">${d.name}</div>
      <div class="text-[11px] text-slate-400 text-center">${d.sub}</div>
    </button>`;
  }).join('');
}
function renderCards(){
  applyDefaults();
  $('#cards').innerHTML=cardHTML(0)+cardHTML(1);
  $('#roster').innerHTML=rosterHTML();
}
$('#select').addEventListener('click',e=>{
  const b=e.target.closest('[data-act]'); if(!b) return;
  const act=b.dataset.act;
  if(act==='pick'){sel[activeSlot].fighter=b.dataset.v; activeSlot=1-activeSlot; renderCards();}   // fill the highlighted player, then move on to the other
  else if(act==='slot'){activeSlot=+b.dataset.i; renderCards();}
  else if(act==='ctrl'){sel[+b.dataset.i].ctrl=b.dataset.v; renderCards();}
});
// one preview painter for the big slot previews (200px) and the roster tiles (120px)
function drawPreview(c,size,d,c1,c2,t){
  const h=size/2, k=size/200;
  c.setTransform(1,0,0,1,0,0); c.clearRect(0,0,size,size);
  const g=c.createRadialGradient(h,h,0,h,h,h);
  g.addColorStop(0,'#232647'); g.addColorStop(1,'#0c0d1a'); c.fillStyle=g; c.fillRect(0,0,size,size);
  if(d.id==='whirl'){
    c.save(); c.translate(h,h); c.rotate(t*1.2); c.strokeStyle=rgba(c2,.4); c.lineWidth=2*k; c.setLineDash([8*k,10*k]);
    c.beginPath(); c.arc(0,0,92*k,0,TAU); c.stroke(); c.restore();
  }
  drawTop(c,{id:d.id,x:h,y:h,r:d.r*d.prev*k,angle:t*({bigboy:8,clockwork:12,scrapking:9}[d.id]||20),c1,c2,hp:1,rage:d.id==='bigboy'?.5+.5*Math.sin(t*1.5):0,t,
    clk:d.id==='clockwork'?previewClk(t):null});
}
function renderPreviews(t){
  document.querySelectorAll('canvas[data-prev]').forEach(cn=>{
    const s=sel[+cn.dataset.prev];
    drawPreview(cn.getContext('2d'),200,DEFS[s.fighter],s.c1,s.c2,t);
  });
  document.querySelectorAll('canvas[data-roster]').forEach(cn=>{
    const d=DEFS[cn.dataset.roster], p=SIG[d.id].main;
    drawPreview(cn.getContext('2d'),120,d,p[0],p[1],t);
  });
}

/* =====================================================================
   INPUT & BUTTONS
   ===================================================================== */
addEventListener('pointerdown',()=>SFX.unlock());
// every button (and clickable card) gets a click sound; data-sfx picks the variant. Bubbling, so the mute button's own
// handler has already run: muting is silent and unmuting confirms with a click.
document.addEventListener('click',e=>{
  const b=e.target.closest('button,[data-act]');
  if(b) SFX.click(b.dataset.sfx);
});
function syncMute(){ $('#btnMute').textContent=SFX.isMuted()?'SND OFF':'SND ON'; }
addEventListener('keydown',e=>{
  keys[e.code]=true; SFX.unlock();
  if(e.code==='KeyM'){SFX.toggleMute(); syncMute();}
  if(state==='game'&&['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.code)) e.preventDefault();
  if((e.code==='KeyP'||e.code==='Escape')&&state==='game'&&game&&!(game.over&&game.endShown)) setPause(!game.paused);
});
addEventListener('keyup',e=>{keys[e.code]=false;});
addEventListener('blur',()=>{for(const k in keys) keys[k]=false; if(state==='game'&&game&&!game.over) setPause(true);});

$('#btnPlay').onclick=()=>setScreen('select');
$('#btnHow').onclick=()=>$('#how').classList.toggle('hidden');
$('#btnBack').onclick=()=>setScreen('menu');
$('#btnFight').onclick=startGame;
$('#btnPause').onclick=()=>setPause(true);
$('#btnMute').onclick=()=>{SFX.unlock(); SFX.toggleMute(); syncMute();};
syncMute();
$('#pResume').onclick=()=>setPause(false);
$('#pRestart').onclick=startGame;
$('#pSelect').onclick=()=>setScreen('select');
$('#pMenu').onclick=()=>setScreen('menu');
$('#eAgain').onclick=startGame;
$('#eSelect').onclick=()=>setScreen('select');
$('#eMenu').onclick=()=>setScreen('menu');

/* =====================================================================
   MAIN LOOP
   ===================================================================== */
let last=performance.now();
function frame(now){
  const rdt=Math.min(.05,(now-last)/1000); last=now;
  if(state==='game'&&game){updateGame(rdt); renderGame();}
  else {renderBg(rdt); if(state==='select') renderPreviews(now/1000); SFX.silence();}
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);
