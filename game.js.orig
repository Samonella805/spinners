let state = 'menu';
let game = null;
const sel = [
  {fighter:'bigboy', ctrl:'human', c1:'#e8442b', c2:'#ffc93c', mirror:false},
  {fighter:'whirl',  ctrl:'cpu',   c1:'#7c4dff', c2:'#2ef2d0', mirror:false}
];
const keys = {};
